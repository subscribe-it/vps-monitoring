# =============================================================================
#  monitoring — komplet zmiennych dla Portainera
#  Portainer → Stacks → monitoring → Environment variables (można wkleić hurtem)
#
#  ZASADA: żadna z tych wartości nie jest zapisana w repozytorium.
#  Wszystkie trafiają wyłącznie do konfiguracji stacka w Portainerze.
# =============================================================================

# --- domena i certyfikat -----------------------------------------------------
# Domena, pod którą stoją wszystkie panele (rekord A w RapidDC → 57.129.41.248)
MONITORING_DOMAIN=monitoring.subscribeit.pl
# Nazwa resolvera ACME w Twoim edge (sprawdzone: letsencrypt)
TRAEFIK_CERT_RESOLVER=letsencrypt
TZ=Europe/Warsaw

# --- logowanie do paneli (ForwardAuth) --------------------------------------
# Hash wygeneruj lokalnie:
#   docker run --rm httpd:2.4-alpine htpasswd -nbB admin 'TWOJE_HASLO'
# UWAGA: Portainer zamienia $$ na $, więc każdy znak $ wpisz podwójnie.
# Skrypt obsługuje OBA warianty, więc jeśli logowanie nie działa — spróbuj bez podwajania.
PANEL_AUTH_USER=admin
PANEL_AUTH_PASSWORD_HTPASSWD=admin:$$2y$$05$$ZMIEN_NA_PRAWDZIWY_HASH

# --- Grafana ----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ZMIEN_NA_SILNE_HASLO
# true = logowanie do Grafany przez nagłówek z ForwardAuth (jedno logowanie na całość)
GRAFANA_AUTH_PROXY=true

# --- retencja danych --------------------------------------------------------
PROMETHEUS_RETENTION=30d
PROMETHEUS_RETENTION_SIZE=8GB
LOKI_RETENTION=720h

# --- kanał 1: ntfy (push na telefon) ----------------------------------------
NTFY_URL=https://ntfy.sh
# długi, losowy temat — traktuj go jak hasło
NTFY_TOPIC=zmien-na-dlugi-losowy-temat
# token z konta ntfy (Access tokens) — bez niego temat jest publiczny dla znających nazwę
NTFY_TOKEN=
NTFY_PRIORITY_CRITICAL=urgent
# urgent = brzęczy; low/min = cicho (widać rano). Domyślnie hałasuje TYLKO critical.
NTFY_PRIORITY_WARNING=low
NTFY_PRIORITY_INFO=min

# --- kanał 2: e-mail (zapasowy i dziennik) ----------------------------------
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# od jakiego poziomu wysyłać e-maile: info | warning | critical
EMAIL_MIN_SEVERITY=warning

# --- kanał 3: healthchecks.io (zewnętrzny watchdog) ------------------------
# Trzy checki typu Simple (cron). Wklej ich ping URL-e (format https://hc-ping.com/<uuid>).
HC_PING_ALL_OK=
HC_PING_MONITORING=
HC_PING_BACKUP=
WATCHDOG_PING=true

# --- notifier: zdarzenia zewnętrzne (np. nieudany deploy z GitHub Actions) --
NOTIFIER_TOKEN=
RUNBOOK_BASE_URL=https://github.com/subscribe-it/vps-monitoring/blob/main/docs/RUNBOOK.md

# --- progi monitoringu ------------------------------------------------------
HEALTH_PING_INTERVAL_SECONDS=120
BACKUP_MAX_AGE_HOURS=26
BACKUP_MIN_SIZE_MB=1
DISK_MIN_FREE_PERCENT=15
INODES_MIN_FREE_PERCENT=10
CERT_MIN_DAYS=14
RESTORE_TEST_MAX_DAYS=45

# --- dostęp do gniazda Dockera -------------------------------------------------
# GID grupy `docker` na hoście. Sprawdź: stat -c %g /var/run/docker.sock
# Zła wartość = discovery nie odczyta usług (panel pokaże warning, zadziała
# alert DiscoveryDown — nie jest to ciche).
DOCKER_GID=999

# --- auto-discovery nowych aplikacji ---------------------------------------
DISCOVERY_REFRESH_SECONDS=30
# stacki całkowicie pomijane (nasz własny + pozostałości po starym edge)
DISCOVERY_SKIP_STACKS=monitoring,traefik,traefik_stack
DISCOVERY_SKIP_SERVICES=
# stacki, których awaria dzwoni w nocy (push), reszta to ostrzeżenia (tylko e-mail)
CRITICAL_STACKS=ventiplan-prod,jpolski_na6_pl_prod,star-sign,bugsink,portainer-edge-gateway
WARN_STACKS=kosmetix-staging,staging_mdi-studio
DEFAULT_PROBE_PATH=/
BLACKBOX_MODULE=http_2xx
PROBE_TIMEOUT_SECONDS=5
SERVICES_IGNORE_STACKS=monitoring,kosmetix-staging,staging_mdi-studio

# --- backup (watchdog czyta logi usługi backupu) ---------------------------
# --- weryfikacja backupów w Cloudflare R2 (token TYLKO do odczytu!) --------
# Gdy podane, watchdog sprawdza, czy świeży dump FAKTYCZNIE leży w buckecie
# (wiek i rozmiar obiektu), a logi usługi backupu są już tylko zapasem.
R2_ENDPOINT=
R2_BUCKET=ventiplan-backups
R2_PREFIX=postgres/
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_REGION=auto

BACKUP_SERVICE=ventiplan-prod_db-backup
# opcjonalny regex znacznika udanego backupu, np: "backup.*ok|uploaded"
BACKUP_SUCCESS_REGEX=
