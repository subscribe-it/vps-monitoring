# ============================================================
# VPS Monitoring Stack - Environment Variables
# Copy these to Portainer Stack → Environment Variables
# ============================================================

# --- REQUIRED ---

# IP or domain of your VPS (used for Traefik routing and external URLs)
MONITORING_HOST=your-vps-ip-or-domain.com

# Grafana admin password (min 8 chars)
GRAFANA_ADMIN_PASSWORD=ChangeMe123!

# --- TELEGRAM ALERTS (recommended) ---

# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Get from https://api.telegram.org/bot<TOKEN>/getUpdates after sending message to bot
TELEGRAM_CHAT_ID=

# --- MARIADB EXPORTERS ---
# Format: user:password@tcp(container_name:3306)/
# Create a read-only user in each MariaDB:
#   CREATE USER 'exporter'@'%' IDENTIFIED BY 'StrongPassword';
#   GRANT PROCESS, REPLICATION CLIENT, SELECT ON *.* TO 'exporter'@'%';
#   FLUSH PRIVILEGES;

JPOLSKI_MARIADB_DSN=exporter:StrongPassword@tcp(jpolski_na6_pl_prod_mariadb.1:3306)/
KOSMETIX_MARIADB_DSN=exporter:StrongPassword@tcp(kosmetix-staging_mariadb.1:3306)/

# --- OPTIONAL ---

GRAFANA_ADMIN_USER=admin
GRAFANA_URL=http://grafana:3000
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_RETENTION=720h
LOKI_RETENTION_DAYS=720
CHECK_INTERVAL=60
UPTIME_KUMA_USERNAME=admin
UPTIME_KUMA_PASSWORD=

# Pattern for WordPress stack auto-discovery (regex)
WORDPRESS_STACK_PATTERN=.*wordpress.*|.*_prod_.*
