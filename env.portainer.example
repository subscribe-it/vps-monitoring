# ============================================
# VPS Monitoring Stack - Environment Variables
# ============================================
# Skopiuj te zmienne do Portainer: 
# Stacks → monitoring → Editor → Environment variables
# ============================================

# Grafana Configuration
GRAFANA_ADMIN_PASSWORD=twoje_bezpieczne_haslo_grafana
GRAFANA_ADMIN_USER=admin

# Monitoring Host Configuration
# IP Twojego serwera VPS (używane w Traefik routing)
MONITORING_HOST=57.129.41.248

# Prometheus Configuration
# Retention period dla danych Prometheus
# Format: {liczba}h (godziny) lub {liczba}d (dni)
# Przykłady: 720h (30 dni), 2160h (90 dni), 30d
PROMETHEUS_RETENTION=720h

# Loki Configuration
# Retention period dla logów Loki (w godzinach)
# Przykłady: 720 (30 dni), 2160 (90 dni)
LOKI_RETENTION_DAYS=720

# Dashboard Automation Configuration
# URL Grafana API (używane przez dashboard-automation)
GRAFANA_URL=http://grafana:3000

# URL Prometheus API (używane przez dashboard-automation)
PROMETHEUS_URL=http://prometheus:9090

# Interwał sprawdzania nowych kontenerów przez dashboard-automation (w sekundach)
CHECK_INTERVAL=60

# Telegram Alerting Configuration
# Token bota Telegram (z @BotFather)
# Jak uzyskać: https://t.me/BotFather → /newbot → skopiuj token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Chat ID Telegram (ID czatu/channelu gdzie bot ma wysyłać alerty)
# Jak uzyskać: 
# - Napisz do bota, potem otwórz: https://api.telegram.org/bot<TOKEN>/getUpdates
# - Znajdź "chat":{"id":123456789} w odpowiedzi
# - Dla kanałów: ID jest ujemne
TELEGRAM_CHAT_ID=123456789

# ============================================
# Opcjonalne zmienne (mają domyślne wartości)
# ============================================

# Port dla telegram-webhook (domyślnie 8080)
# PORT=8080

# Grafana Admin User (domyślnie admin)
# GRAFANA_ADMIN_USER=admin

# Grafana URL (domyślnie http://grafana:3000)
# GRAFANA_URL=http://grafana:3000

# Prometheus URL (domyślnie http://prometheus:9090)
# PROMETHEUS_URL=http://prometheus:9090

# Check interval dla dashboard-automation (domyślnie 60 sekund)
# CHECK_INTERVAL=60

# ============================================
# Instrukcje dodania w Portainer:
# ============================================
# 1. Otwórz Portainer → Stacks
# 2. Wybierz stack "monitoring"
# 3. Kliknij "Editor" (lub "Update the stack")
# 4. W sekcji "Environment variables" dodaj zmienne:
#    - Kliknij "Add environment variable"
#    - Name: GRAFANA_ADMIN_PASSWORD
#    - Value: twoje_haslo
#    - Powtórz dla wszystkich zmiennych
# 5. Zapisz i zaktualizuj stack
# ============================================

