  "description": "Wydajność i dostępność monitorowanych adresów: czasy odpowiedzi sond blackbox, dostępność w oknach 24 h/7 d/30 d oraz regresje wobec własnej normy. Powstał po incydencie 22.09.2026, gdy degradację stron zauważyli klienci, a nie monitoring.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Domena — teraz, norma i dostępność",
      "description": "Jedna linia na monitorowany adres: czas odpowiedzi teraz, mediana i p95 z 6 godzin oraz dostępność w oknach 24 h i 30 dni.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "probe_duration_seconds{job=~\"blackbox-(public|monitoring)\"}",
          "instant": true,
          "format": "table",
          "legendFormat": "teraz"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.5, probe_duration_seconds{job=~\"blackbox-(public|monitoring)\"}[6h])",
          "instant": true,
          "format": "table",
          "legendFormat": "mediana 6 h"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.95, probe_duration_seconds{job=~\"blackbox-(public|monitoring)\"}[6h])",
          "instant": true,
          "format": "table",
          "legendFormat": "p95 6 h"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "avg_over_time(probe_success{job=~\"blackbox-(public|monitoring)\"}[24h]) * 100",
          "instant": true,
          "format": "table",
          "legendFormat": "dostępność 24 h %"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "avg_over_time(probe_success{job=~\"blackbox-(public|monitoring)\"}[30d]) * 100",
          "instant": true,
          "format": "table",
          "legendFormat": "dostępność 30 d %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*%"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 2
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 99
                    },
                    {
                      "color": "green",
                      "value": 99.9
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "teraz|mediana 6 h|p95 6 h"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
