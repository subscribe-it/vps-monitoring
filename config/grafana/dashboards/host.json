    {
      "type": "table",
      "title": "Systemy plikow — uzycie (%)",
      "description": "Zapełnienie wszystkich realnych systemow plikow (bez tmpfs, overlay i wnetrza Dockera). Progi zgodne z alertami: 85% (wolne <15%, warning) i 92% (wolne <8%, critical).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 - (node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|ramfs|squashfs|autofs\",mountpoint!~\"/var/lib/docker/.+|/run/.+|/sys/.+|/proc/.+\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|ramfs|squashfs|autofs\",mountpoint!~\"/var/lib/docker/.+|/run/.+|/sys/.+|/proc/.+\"}) * 100",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 85
              },
              {
                "color": "red",
                "value": 92
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "color-background",
              "mode": "basic"
            },
            "inspect": false,
            "filterable": false,
            "minWidth": 60,
            "footer": {
