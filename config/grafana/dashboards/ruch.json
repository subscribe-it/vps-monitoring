    "list": [
      {
        "name": "stack",
        "label": "Stack (aplikacja)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(swarm_container_cpu_percent, stack)",
        "query": {
          "query": "label_values(swarm_container_cpu_percent, stack)",
          "refId": "stack"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "usluga",
        "label": "Usługa",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(swarm_container_cpu_percent{stack=~\"$stack\"}, service)",
        "query": {
          "query": "label_values(swarm_container_cpu_percent{stack=~\"$stack\"}, service)",
          "refId": "usluga"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "domena",
        "label": "Domena (ruch HTTP)",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values({job=\"traefik\"}, RequestHost)",
        "query": {
          "query": "label_values({job=\"traefik\"}, RequestHost)",
          "refId": "domena"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
