              {
                "id": "custom.width",
                "value": 100
              },
              {
                "id": "custom.align",
                "value": "center"
              },
              {
                "id": "displayName",
                "value": "brakuje"
              },
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "running"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.align",
                "value": "center"
              },
              {
                "id": "displayName",
                "value": "running"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "desired"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.align",
                "value": "center"
              },
              {
                "id": "displayName",
                "value": "desired"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        },
        "sortBy": []
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "target",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "__name__": true,
              "__name__ 1": true,
              "__name__ 2": true,
              "stack": true,
              "stack 1": true,
              "stack 2": true,
              "service": true,
              "service 1": true,
              "service 2": true,
              "sep 1": true,
              "sep 2": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "Value #A": "running",
              "Value #B": "desired",
              "target": "usluga"
            },
            "indexByName": {}
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "brakuje",
            "mode": "binary",
            "replaceFields": false,
            "binary": {
              "left": "desired",
              "operator": "-",
              "right": "running"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "running",
                "destinationType": "string"
              },
              {
                "targetField": "desired",
                "destinationType": "string"
              }
            ]
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "rs",
            "mode": "binary",
            "replaceFields": false,
            "binary": {
              "left": "running",
              "operator": "+",
              "right": "sep"
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "replicas",
            "mode": "binary",
            "replaceFields": false,
            "binary": {
              "left": "rs",
              "operator": "+",
              "right": "desired"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "sep": true,
              "rs": true,
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true
            },
            "renameByName": {},
            "indexByName": {
              "usluga": 0,
              "replicas": 1,
              "running": 2,
              "desired": 3,
              "brakuje": 4
            }
          }
        }
      ],
      "id": 2,
