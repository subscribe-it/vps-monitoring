    {
      "type": "table",
      "title": "Repliki uslug (running/desired)",
      "description": "Repliki dzialajace i oczekiwane dla wszystkich uslug wybranego stacka. Kolumna replicas to running/desired, kolumna brakuje to roznica desired minus running. Nowa usluga pojawia sie tutaj automatycznie po wykryciu przez discovery.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "label_replace(label_join(swarm_service_running_replicas{stack=\"$stack\"}, \"target\", \"/\", \"stack\", \"service\"), \"sep\", \"/\", \"target\", \".*\")",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "label_join(swarm_service_desired_replicas{stack=\"$stack\"}, \"target\", \"/\", \"stack\", \"service\")",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": false,
            "minWidth": 60,
            "footer": {
              "show": false,
              "reducer": [
                "sum"
              ],
              "countRows": false,
              "fields": ""
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "replicas"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "custom.align",
                "value": "center"
              },
              {
                "id": "displayName",
                "value": "replicas (running/desired)"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "brakuje"
            },
