    function renderSecurity(security: Security | null, loginy: Login[] | null = null): void {
      const grid = section('security');
      if (!grid) return;
      updateSection('security', security ? [security.state] : [], security ? '1' : '0');
      emptyState('security', security === null);

      if (!security) {
        setField('security-state', DASH, 'brak danych', 'unknown');
        setField('security-failed', DASH, '', 'unknown');
        setField('security-bans', DASH, '', 'unknown');
      } else {
        setField('security-state', stateLabel(security.state), 'stan z /status/api.json', security.state);
        setField('security-failed', fmtInt(security.ssh_failed_24h), 'nieudane próby SSH', security.state);
        setField('security-bans', fmtInt(security.ssh_bans_24h), 'zablokowane adresy', security.state);
      }

      const logins = loginy ?? security?.logins_24h ?? [];
      setText(grid, '[data-role="logins-count"]', String(logins.length));
      const emptyLogins = q<HTMLElement>(grid, '[data-role="logins-empty"]');
      if (emptyLogins) emptyLogins.hidden = logins.length > 0;

      if (!stale('logins', logins)) return;
      const holder = q<HTMLElement>(grid, '[data-role="logins"]');
      if (!holder) return;
      holder.replaceChildren();

      for (const login of logins) {
        const row = instantiate('tpl-login-row');
        if (!row) continue;
        setTextWithTitle(row, '[data-role="service"]', login.service);
        setTextWithTitle(row, '[data-role="ip"]', login.ip);
        setText(row, '[data-role="at"]', fmtDateTimeUTC(login.at));
