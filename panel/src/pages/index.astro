    function renderAlerts(alerts: Alert[]): void {
      const grid = section('alerts');
      if (!grid) return;
      updateSection(
        'alerts',
        alerts.length > 0 ? alerts.map((alert) => alert.severity) : [],
        String(alerts.length),
      );
      if (alerts.length === 0) {
        // Brak alertów to dobry stan — sekcja jest zielona, nie „nieznana”.
        grid.dataset.state = 'ok';
        setText(grid, '[data-role="rollup-label"]', 'Brak alertów');
        const rollup = q<HTMLElement>(grid, '[data-role="rollup"]');
        rollup?.setAttribute('aria-label', 'Stan sekcji: brak aktywnych alertów');
      }

      const clear = q<HTMLElement>(grid, '[data-role="empty-clear"]');
      if (clear) clear.hidden = alerts.length > 0;
      const empty = q<HTMLElement>(grid, '[data-role="empty"]');
      if (empty) empty.hidden = true;

      if (!stale('alerts', alerts)) return;
      const holder = q<HTMLElement>(grid, '[data-role="list"]');
      if (!holder) return;
      holder.replaceChildren();

      for (const alert of alerts) {
        const row = instantiate('tpl-alert-row');
        if (!row) continue;
        row.dataset.state = alert.severity;
        setTextWithTitle(row, '[data-role="name"]', alert.name);
        setText(row, '[data-role="severity"]', severityLabel(alert.severity));
        setTextWithTitle(row, '[data-role="alert-stack"]', alert.stack ?? '');
        setTextWithTitle(row, '[data-role="summary"]', alert.summary ?? '');
        setText(row, '[data-role="since"]', alert.since ? `od ${fmtTimeUTC(alert.since)}` : '');
