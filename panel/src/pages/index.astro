    /* ---------------- banner + znacznik czasu ---------------- */

    function renderBanner(): void {
      const banner = q<HTMLElement>(app, '[data-role="banner"]');
      if (!banner || banner.hidden) return;
      banner.dataset.state = lastGoodAt ? 'warning' : 'critical';
      setText(banner, '[data-role="banner-title"]', lastGoodAt ? 'Brak danych' : 'Brak danych — nic nie pobrano');
      setText(
        banner,
        '[data-role="banner-text"]',
        lastGoodAt
          ? `Ostatnia udana aktualizacja o ${fmtDateTimeUTC(lastGoodAt)} (${fmtAgo(lastGoodAt)}). Pokazuję ostatni znany stan i ponawiam co ${refreshSeconds} s.`
          : `Nie udało się pobrać ${endpoint}. Ponawiam co ${refreshSeconds} s.`,
      );
    }

    function showBanner(): void {
      const banner = q<HTMLElement>(app, '[data-role="banner"]');
      if (!banner) return;
      banner.hidden = false;
      renderBanner();
    }

    function hideBanner(): void {
      const banner = q<HTMLElement>(app, '[data-role="banner"]');
      if (banner) banner.hidden = true;
    }

    function renderMeta(): void {
      const age = lastGoodAt ? Date.now() - lastGoodAt.getTime() : null;
      const isStale = age === null || age > refreshMs * 3;
      const fresh: State = lastGoodAt ? (isStale ? 'warning' : 'ok') : 'unknown';

      /*
       * Świeżość danych mieszka w pasku przyklejonym: to jedyne miejsce
       * widoczne przez całe przewijanie, więc tam musi być odpowiedź na pytanie
       * „czy patrzę na aktualny stan?".
       */
      const bar = section('sticky');
      if (bar) {
        setState(bar, '[data-role="sticky-fresh"]', fresh);
        setText(bar, '[data-role="sticky-updated"]', lastGoodAt ? fmtTimeUTC(lastGoodAt) : DASH);
        setText(bar, '[data-role="sticky-ago"]', lastGoodAt ? fmtAgo(lastGoodAt) : 'brak danych');
      }

      // Auto-odświeżanie bez osobnej linii tekstu: informacja w podpowiedzi akcji.
      const refreshButton = q<HTMLButtonElement>(app, '[data-action="refresh"]');
      if (refreshButton) {
        refreshButton.title = `Odśwież teraz — automatycznie co ${refreshSeconds} s`;
      }
    }

    /* ---------------- pobieranie danych ---------------- */

    async function fetchWithTimeout(url: string): Promise<Response> {
      const controller = new AbortController();
      const timer = window.setTimeout(() => controller.abort(), requestTimeoutMs);
      try {
        return await fetch(url, {
          signal: controller.signal,
          credentials: 'same-origin',
          cache: 'no-store',
          headers: { accept: 'application/json' },
        });
      } finally {
        window.clearTimeout(timer);
      }
    }

    /*
     * Stan „nigdy nie pobrano danych”: każda sekcja dostaje jawny komunikat
     * „brak danych”, a nie pustą kartę. Wołane tylko wtedy, gdy nie mamy
     * jeszcze żadnego udanego odczytu (inaczej trzymamy ostatnie dane).
     */
    function renderNoData(): void {
      for (const key of ['checks', 'stacks', 'certs', 'backup', 'security', 'alerts', 'tools']) {
        const el = section(key);
        if (!el) continue;
        el.dataset.state = 'unknown';
        setText(el, '[data-role="count"]', DASH);
        setText(el, '[data-role="rollup-label"]', 'Nieznany');
        const rollup = q<HTMLElement>(el, '[data-role="rollup"]');
        rollup?.setAttribute('aria-label', 'Stan sekcji: brak danych');
        const empty = q<HTMLElement>(el, '[data-role="empty"]');
        if (empty) empty.hidden = false;
      }
      // Pasek przyklejony musi powiedzieć prawdę także wtedy, gdy nie ma danych.
      const bar = section('sticky');
      if (bar) {
        bar.dataset.state = 'unknown';
        setText(bar, '[data-role="sticky-label"]', 'Brak danych');
        setText(bar, '[data-role="sticky-note"]', 'nie udało się pobrać stanu z API');
      }

      // „Brak aktywnych alertów” byłoby nieprawdą — nie wiemy, czy są.
      const clear = q<HTMLElement>(app, '[data-section="alerts"] [data-role="empty-clear"]');
      if (clear) clear.hidden = true;
    }

    async function load(): Promise<void> {
      if (inFlight) return;
      inFlight = true;
      try {
        const response = await fetchWithTimeout(endpoint);
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const payload: unknown = await response.json();
        const parsed = parseStatus(payload);
        // Odpowiedź 200 z treścią, która nie jest snapshotem (np. JSON błędu),
        // musi być potraktowana jak awaria — inaczej skasowałaby ostatnie dane.
        if (!isStatusSnapshot(parsed)) throw new Error('nieoczekiwany kształt odpowiedzi');

        // Poprzedni stan staje się punktem odniesienia dla „Ostatnich zmian".
        poprzedni = snapshot;
        snapshot = parsed;
        lastGoodAt = new Date();
        hideBanner();
        renderAll();
      } catch {
        // Świadomie bez `console.error`: awaria sieci nie może zaśmiecać konsoli
        // ani czyścić widoku. Ostatnie dane zostają na ekranie.
        if (!snapshot) renderNoData();
        showBanner();
      } finally {
        inFlight = false;
        renderMeta();
      }
    }
    function renderAll(): void {
      if (!snapshot) return;
      const overall = deriveOverall(snapshot);
      const widok = przygotujWidok(snapshot);
      renderHeader(snapshot, overall);
      renderHost(snapshot.host);
      renderTools(snapshot.tools);
      renderAlerts(widok.alerty.pozycje);
      renderZmiany();
      renderChecks(widok.checki.pozycje);
      renderStacks(widok.stacki.stacki);
      renderCerts(widok.certy.pozycje);
      renderBackup(snapshot.backup);
      renderSecurity(snapshot.security, widok.logowania.pozycje);
      /*
       * Kolejność ma znaczenie: sekcje ustawiają własne stany „brak danych",
       * a `renderFiltry` koryguje je po nich — filtr, który coś ukrył, to nie
       * to samo, co brak danych z API.
       */
      renderFiltry(widok);
      applyRoute();
    }

    /* ---------------- routing po hashu ---------------- */

    interface RouteStatus {
      kind: 'status';
    }
    interface RouteTool {
      kind: 'tool';
      id: string;
    }
    interface RouteWykresy {
      kind: 'wykresy';
      /** `null` = cały VPS, `wszystkie` = lista usług, inaczej `stack/usługa`. */
      podmiot: string | null;
      zakres: ZakresId;
      odswiez: OdswiezId;
    }
    interface RouteLogi {
      kind: 'logi';
      usluga: string | null;
      zakres: ZakresLogowId;
      zrodlo: ZrodloLogowId;
    }
    type Route = RouteStatus | RouteTool | RouteWykresy | RouteLogi;

    function parseRoute(): Route {
      if (czyTrasaLogow(window.location.hash)) {
        const trasa = zHaszaLogi(window.location.hash);
        return { kind: 'logi', usluga: trasa.usluga, zakres: trasa.zakres, zrodlo: trasa.zrodlo };
      }
      if (czyTrasaWykresow(window.location.hash)) {
        const trasa = zHaszaWykresy(window.location.hash);
        return {
          kind: 'wykresy',
          podmiot: trasa.podmiot,
          zakres: trasa.zakres,
          odswiez: trasa.odswiez,
        };
      }
      const match = /^#\/tool\/(.+)$/.exec(window.location.hash);
      const id = match?.[1];
      return id ? { kind: 'tool', id: decodeURIComponent(id) } : { kind: 'status' };
    }

    function setFrameMessage(text: string | null): void {
      const holder = q<HTMLElement>(app, '[data-role="frame-message"]');
      if (!holder) return;
      setText(holder, '[data-role="frame-message-text"]', text ?? '');
      holder.hidden = text === null;
    }

    /*
     * Widoczność widoków przełączamy atrybutem `hidden` (ma `display: none`
     * z `!important`), a nie klasami układu — w Tailwind v4 warstwa `utilities`
     * jest po `components`, więc klasa narzędziowa wygrałaby z regułą widoku.
     */
    function setStatusViewVisible(visible: boolean): void {
      const statusView = q<HTMLElement>(app, '[data-role="status-view"]');
      if (statusView) statusView.hidden = !visible;
    }

    /** Widok wykresów to osobna „strona" panelu — pokazujemy dokładnie jeden widok. */
    function setWykresyViewVisible(visible: boolean): void {
      const wykresy = q<HTMLElement>(app, '[data-role="wykresy-view"]');
      if (wykresy) wykresy.hidden = !visible;
    }

    /** Widok logów — druga „podstrona" panelu (obok wykresów). */
    function setLogiViewVisible(visible: boolean): void {
      const logi = q<HTMLElement>(app, '[data-role="logi-view"]');
      if (logi) logi.hidden = !visible;
    }

    function showStatus(): void {
      app.dataset.view = 'status';
      zatrzymajTimerWykresow();
      setStatusViewVisible(true);
      setWykresyViewVisible(false);
      setLogiViewVisible(false);
      const wrap = q<HTMLElement>(app, '[data-role="frame-wrap"]');
      if (wrap) wrap.hidden = true;
      highlightActiveTool(null);
      document.title = 'Panel monitoringu — stan usług';
    }

    function showTool(id: string): void {
      const wrap = q<HTMLElement>(app, '[data-role="frame-wrap"]');
      app.dataset.view = 'tool';
      zatrzymajTimerWykresow();
      setStatusViewVisible(false);
      setWykresyViewVisible(false);
      setLogiViewVisible(false);
      setLogiViewVisible(false);
      if (wrap) wrap.hidden = false;
      highlightActiveTool(id);

      const tool = snapshot?.tools.find((item) => item.id === id) ?? null;
      const open = q<HTMLAnchorElement>(app, '[data-role="frame-open"]');
      const openMobile = q<HTMLAnchorElement>(app, '[data-role="frame-open-mobile"]');

      // Powrót prowadzi do ostatniego widoku stanu (z filtrem i fokusem), a nie
      // do gołego `#/` — wejście w podgląd nie może kasować ustawień widoku.
      for (const powrot of qa<HTMLAnchorElement>(app, '[data-role="back"]')) {
        powrot.href = ostatniHaszStatusu;
      }

      setText(app, '[data-role="frame-title"]', tool ? tool.name : id);
      setState(app, '[data-role="frame-state"]', tool ? tool.state : 'unknown');
      setText(app, '[data-role="frame-state-label"]', tool ? stateLabel(tool.state) : 'Nieznany');
      document.title = `${tool ? tool.name : id} — panel monitoringu`;

      if (!tool) {
        setFrameMessage(
          snapshot
            ? `Nie znaleziono narzędzia „${id}”. Wróć do widoku stanu, aby zobaczyć listę dostępnych narzędzi.`
            : 'Wczytywanie danych o narzędziach…',
        );
        if (open) open.hidden = true;
        if (openMobile) openMobile.hidden = true;
        return;
      }

      const canOpen = Boolean(tool.url);
      if (open) {
        if (canOpen && tool.url) open.href = tool.url;
        open.hidden = !canOpen;
      }
      if (openMobile) {
        if (canOpen && tool.url) openMobile.href = tool.url;
        openMobile.hidden = !canOpen;
      }

      if (!tool.embed || !tool.url) {
        setFrameMessage(
          `„${tool.name}” otwiera się w nowej karcie — ten panel nie osadza go w podglądzie.`,
        );
        return;
      }

      setFrameMessage(null);
      mountFrame(tool);
    }

    function mountFrame(tool: Tool): void {
      const holder = q<HTMLElement>(app, '[data-role="frame-holder"]');
      if (!holder || !tool.url) return;
      if (mountedToolId === tool.id && frame) return;

      // Trzymamy dokładnie jedną ramkę: przełączenie narzędzia ładuje nowe.
      holder.replaceChildren();
      const next = document.createElement('iframe');
      next.className = 'frame-ops';
      next.src = embedSrc(tool);
      next.title = `Podgląd narzędzia: ${tool.name}`;
      next.setAttribute('referrerpolicy', 'same-origin');
      holder.append(next);
      frame = next;
      mountedToolId = tool.id;
    }

    function applyRoute(): void {
      const route = parseRoute();
      if (route.kind === 'tool') showTool(route.id);
      else if (route.kind === 'wykresy') showWykresy(route);
      else if (route.kind === 'logi') showLogi(route);
      else showStatus();
    }

    /**
     * Widok logów. Trasa niesie usługę, zakres i źródło, więc widok odtwarza
     * się z adresu — link „te logi w 24 h" działa i przeżywa odświeżenie.
     */
    function showLogi(route: RouteLogi): void {
      app.dataset.view = 'logi';
      zatrzymajTimerWykresow();
      setStatusViewVisible(false);
      setWykresyViewVisible(false);
      setLogiViewVisible(true);
      const wrap = q<HTMLElement>(app, '[data-role="frame-wrap"]');
      if (wrap) wrap.hidden = true;
      highlightActiveTool(null);

      const powrot = q<HTMLAnchorElement>(app, '[data-role="logi-powrot"]');
      if (powrot) powrot.href = ostatniHaszStatusu;

      for (const przycisk of qa<HTMLElement>(app, '[data-action="log-zakres"]')) {
        przycisk.setAttribute(
          'aria-pressed',
          przycisk.dataset.zakres === route.zakres ? 'true' : 'false',
        );
      }

      const zakres = zakresLogowZId(route.zakres);
      const naglowek = q<HTMLElement>(app, '[data-role="logi-naglowek"]');
      const podpis = q<HTMLElement>(app, '[data-role="logi-podpis"]');
      if (route.usluga) {
        if (naglowek) naglowek.textContent = `Logi · ${route.usluga}`;
        if (podpis) podpis.textContent = `Kontenery usługi · ${zakres.podpis}`;
        document.title = `${route.usluga} — logi panelu monitoringu`;
      } else {
        if (naglowek) naglowekLogow(route.zrodlo, naglowek);
        if (podpis) podpis.textContent = `Logi · ${zakres.podpis}`;
        document.title = 'Logi — panel monitoringu';
      }

      void renderLogi(route, zakres);
    }

    /** Nagłówek listy bez wybranej usługi zależy od źródła. */
    function naglowekLogow(zrodlo: ZrodloLogowId, element: HTMLElement): void {
      const zrodloOpis = ZRODLA_LOGOW.find((item) => item.id === zrodlo);
      element.textContent = zrodlo === 'usluga' ? 'Logi' : `Logi · ${zrodloOpis?.nazwa ?? zrodlo}`;
    }

    /**
     * Widok wykresów. Trasa niesie usługę i zakres czasu, więc wygląd odtwarza
     * się z adresu (link do „tej usługi w 24 h" działa).
     */
    function showWykresy(route: RouteWykresy): void {
      app.dataset.view = 'wykresy';
      setStatusViewVisible(false);
      setWykresyViewVisible(true);
      setLogiViewVisible(false);
      const wrap = q<HTMLElement>(app, '[data-role="frame-wrap"]');
      if (wrap) wrap.hidden = true;
      highlightActiveTool(null);

      const powrot = q<HTMLAnchorElement>(app, '[data-role="wykresy-powrot"]');
      if (powrot) powrot.href = ostatniHaszStatusu;

      for (const przycisk of qa<HTMLElement>(app, '[data-action="wykres-zakres"]')) {
        przycisk.setAttribute(
          'aria-pressed',
          przycisk.dataset.zakres === route.zakres ? 'true' : 'false',
        );
      }

      const zakres = zakresZId(route.zakres);
      const odswiezanie = odswiezanieZId(route.odswiez);
      const selectOdswiez = q<HTMLSelectElement>(app, '[data-role="wykresy-odswiez"]');
      if (selectOdswiez) selectOdswiez.value = odswiezanie.id;

      // Ranking „Top 10" ma sens przy przeglądaniu zbioru; przy jednej usłudze
      // tylko rozprasza (ta usługa i tak jest na wykresach).
      const top = q<HTMLElement>(app, '[data-role="wykresy-top"]');
      if (top) top.hidden = Boolean(route.podmiot) && route.podmiot !== PODMIOT_WSZYSTKIE;

      const etykieta = podmiotEtykieta(route.podmiot);
      const naglowek = q<HTMLElement>(app, '[data-role="wykresy-naglowek"]');
      const podpis = q<HTMLElement>(app, '[data-role="wykresy-podpis"]');
      if (naglowek) naglowek.textContent = `Wykresy · ${etykieta}`;
      if (podpis) podpis.textContent = `${podpisZakresu(zakres)} · ${podpisOdswiezania(odswiezanie)}`;
      document.title = route.podmiot
        ? `${etykieta} — wykresy panelu monitoringu`
        : 'Wykresy — panel monitoringu';

      wypelnijPodmioty(route);
      ustawTimerWykresow(odswiezanie.id);
      void renderWykresy(route);
    }

    /**
     * Pełny ekran dla osadzonego narzędzia: ramka zajmuje całe okno razem
     * z paskiem narzędzi panelu. Przy dashboardach z kilkunastoma wykresami
     * to jedyny sposób, żeby oddać im naprawdę całą szerokość i wysokość.
     */
    async function toggleFullscreen(): Promise<void> {
      const wrap = q<HTMLElement>(app, '[data-role="frame-wrap"]');
      if (!wrap) return;
      try {
        if (document.fullscreenElement) await document.exitFullscreen();
        else await wrap.requestFullscreen();
      } catch {
        // Przeglądarka może odmówić (polityka ramek, brak gestu) — wtedy nic nie
        // zmieniamy i nie udajemy, że tryb się włączył.
      }
    }

    function renderFullscreenState(): void {
      const aktywny = document.fullscreenElement !== null;
      const button = q<HTMLElement>(app, '[data-role="frame-fullscreen"]');
      if (!button) return;
      button.setAttribute('aria-pressed', aktywny ? 'true' : 'false');
      setText(
        button,
        '[data-role="frame-fullscreen-label"]',
        aktywny ? 'Zamknij pełny ekran' : 'Pełny ekran',
      );
    }

    /* ---------------- filtry, fokus, CSV, sparkline ---------------- */

    interface Widok {
      stacki: { stacki: Stack[]; pokazano: number; wszystkich: number; ukryteStacki: number };
      checki: { pozycje: Check[]; pokazano: number; wszystkich: number };
      certy: { pozycje: Cert[]; pokazano: number; wszystkich: number };
      alerty: { pozycje: Alert[]; pokazano: number; wszystkich: number };
      logowania: { pozycje: Login[]; pokazano: number; wszystkich: number };
    }

    /** Widok po filtrach — liczony raz na render i przekazywany sekcjom. */
    function przygotujWidok(s: StatusSnapshot): Widok {
      return {
        stacki: przygotujStacki(s.stacks, filtr, fokus),
        checki: filtrujEndpointy(s.checks, filtr),
        certy: filtrujCertyfikaty(s.certs, filtr),
        alerty: filtrujAlerty(s.alerts, filtr),
        logowania: filtrujLogowania(s.security?.logins_24h ?? [], filtr),
      };
    }

    function odswiezWidok(): void {
      syncHash();
      renderAll();
    }

    /**
     * Czy hasz opisuje trasę podglądu narzędzia (`#/tool/<id>`)?
     *
     * Rozróżnienie jest konieczne, bo hasz pełni dwie role: niesie filtr
     * widoku stanu (`#/?q=…`) i trasę podglądu. Klik w kafelek zmienia hasz
     * na trasę, ale `app.dataset.view` jest jeszcze `status` (widok przerysuje
     * się dopiero po `applyRoute`) — bez tego warunku `syncHash` nadpisywał
     * świeżo ustawioną trasę haszem stanu i klik w kafelek „nic nie robił".
     */
    function czyTrasaNarzedzia(hash: string = window.location.hash): boolean {
      return hash.startsWith('#/tool/');
    }

    /**
     * Czy hasz należy do „podstrony" panelu (podgląd narzędzia, wykresy, logi)?
     * Każda z nich niesie własne parametry, więc hasz filtra nie może ich
     * nadpisać — inaczej klik w „Logi" nic by nie robił.
     */
    function czyTrasaPodstrony(hash: string = window.location.hash): boolean {
      return czyTrasaNarzedzia(hash) || czyTrasaWykresow(hash) || czyTrasaLogow(hash);
    }

    function syncHash(): void {
      // Podstrony (narzędzie, wykresy, logi) niosą własne parametry —
      // hasz filtra nie może ich nadpisać.
      if (czyTrasaPodstrony()) return;
      if (app.dataset.view !== 'status') return;
      const docelowy = doHasza(filtr, fokus);
      if (window.location.hash === docelowy) return;
      haszZNaszegoPisania = true;
      try {
        window.history.replaceState(null, '', docelowy);
        ostatniHaszStatusu = docelowy;
      } finally {
        haszZNaszegoPisania = false;
      }
    }

    /** Wejście z linku (albo Wstecz): hasz jest źródłem prawdy dla filtra i fokusu. */
    function wczytajStanZHasza(): void {
      if (haszZNaszegoPisania) return;
      // Podstrony nie zawierają filtra — wejście w nie (i powrót przez Wstecz)
      // nie może kasować ustawień widoku stanu.
      if (czyTrasaPodstrony()) return;
      const stan = zHasza(window.location.hash);
      filtr = stan.filtr;
      fokus = stan.fokus;
      ostatniHaszStatusu = window.location.hash || '#/';
      if (fokus) {
        const czesci = rozbijFokus(fokus);
        if (czesci) zwieteStacki.delete(czesci.stack);
      }
    }

    function wczytajZwiete(): void {
      try {
        const zapis = window.localStorage.getItem(KLUCZ_ZWINIETE);
        if (!zapis) return;
        const nazwy: unknown = JSON.parse(zapis);
        if (Array.isArray(nazwy)) {
          for (const nazwa of nazwy) if (typeof nazwa === 'string') zwieteStacki.add(nazwa);
        }
      } catch {
        // brak localStorage (tryb prywatny) nie może psuć panelu
      }
    }

    function zapiszZwiete(): void {
      try {
        window.localStorage.setItem(KLUCZ_ZWINIETE, JSON.stringify([...zwieteStacki]));
      } catch {
        // jw.
      }
    }

    function ustawStanFiltra(stan: StanFiltra): void {
      filtr = { ...filtr, stan: filtr.stan === stan ? 'wszystko' : stan };
      odswiezWidok();
    }

    function ustawSortowanie(klucz: string): void {
      const poprawny = (KLUCZE_SORTOWANIA as readonly string[]).includes(klucz)
        ? (klucz as KluczSortowania)
        : filtr.sort;
      const tenSam = poprawny === filtr.sort;
      const domyslny = poprawny === 'usluga' || poprawny === 'obraz' ? 'asc' : 'desc';
      filtr = {
        ...filtr,
        sort: poprawny,
        // Ponowny klik w tę samą kolumnę odwraca kierunek (jak w każdym arkuszu).
        kierunek: tenSam ? (filtr.kierunek === 'desc' ? 'asc' : 'desc') : domyslny,
      };
      odswiezWidok();
    }

    function wyczyscFiltr(): void {
      filtr = { ...filtr, q: '', stan: 'wszystko' };
      fokus = null;
      const pole = q<HTMLInputElement>(app, '[data-role="filter-input"]');
      if (pole) pole.value = '';
      odswiezWidok();
    }

    function ustawFiltrStacka(nazwa: string): void {
      if (!nazwa) return;
      const juz = filtr.q.trim() === nazwa;
      filtr = { ...filtr, q: juz ? '' : nazwa };
      const pole = q<HTMLInputElement>(app, '[data-role="filter-input"]');
      if (pole) pole.value = filtr.q;
      odswiezWidok();
    }

    function przelaczZwiniety(stackEl: Element | null): void {
      const nazwa = q<HTMLElement>(stackEl ?? app, '[data-role="stack-name"]')?.textContent?.trim();
      if (!nazwa) return;
      if (zwieteStacki.has(nazwa)) zwieteStacki.delete(nazwa);
      else zwieteStacki.add(nazwa);
      zapiszZwiete();
      renderAll();
    }

    /**
     * Fokus usługi: rozwija wiersz szczegółów, przenosi informację do adresu
     * i (jeśli trzeba) rozwija zwinięty stack. Ponowny klik zamyka szczegóły.
     */
    function przelaczFokus(stack: string, usluga: string): void {
      if (!stack || !usluga) return;
      const klucz = kluczFokusa(stack, usluga);
      fokus = fokus === klucz ? null : klucz;
      if (fokus) {
        zwieteStacki.delete(stack);
        zapiszZwiete();
      }
      odswiezWidok();
    }

    function przewinDoFokusa(): void {
      /*
       * UWAGA na nazwę roli: `detail` należy do wierszy endpointów (jest tam
       * od dawna), więc szczegóły usługi mają własną rolę `usluga-szczegoly`.
       * Zmierzone: wspólna nazwa powodowała, że przewijanie trafiało w losowy
       * wiersz sondy, a testy widziały 17 „szczegółów" zamiast jednego.
       */
      const szczegoly = q<HTMLElement>(app, '[data-role="usluga-szczegoly"]');
      if (!szczegoly) return;
      const bezRuchu = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      szczegoly.scrollIntoView({ block: 'center', behavior: bezRuchu ? 'auto' : 'smooth' });
      const wiersz = szczegoly.previousElementSibling;
      if (wiersz instanceof HTMLElement) {
        wiersz.classList.add('row-fokus');
        window.setTimeout(() => wiersz.classList.remove('row-fokus'), 1600);
      }
    }

    function ustawLink(root: ParentNode, rola: string, href: string): void {
      const link = q<HTMLAnchorElement>(root, `[data-role="${rola}"]`);
      if (link) link.href = href;
    }

    /** Wiersz szczegółów usługi: dane, przyciski kopiowania, linki, przebieg 6 h. */
    /**
     * Diagnostyka usługi w szczegółach (widok stanu i widok wykresów).
     *
     * Panel jest TYLKO DO ODCZYTU: pokazuje, co Docker wie (digest obrazu, czas
     * aktualizacji, restarty, powód padnięcia zadania) i daje gotowe komendy do
     * skopiowania. Żadnej operacji nie wykonujemy stąd — panel ma poświadczenia
     * do Dockera, więc „restart jednym klikiem" byłby zbyt łatwy do przypadkowego
     * użycia. Role są parami, bo oba widoki mają własne prefiksy (`d-*`, `wyk-d-*`).
     */
    interface RoleDiagnostyki {
      digest: string;
      updated: string;
      restarty: string;
      zadanie: string;
      bladLinia: string;
      blad: string;
      obraz: string;
      kopiujPs: string;
      kopiujLogs: string;
      kopiujInspect: string;
      kopiujObraz: string;
      portainer: string;
    }

    const ROLE_STATUS: RoleDiagnostyki = {
      digest: 'd-digest',
      updated: 'd-updated',
      restarty: 'd-restarty',
      zadanie: 'd-zadanie',
      bladLinia: 'd-blad-linia',
      blad: 'd-blad',
      obraz: 'd-obraz',
      kopiujPs: 'kopiuj-ps',
      kopiujLogs: 'kopiuj-logs',
      kopiujInspect: 'kopiuj-inspect',
      kopiujObraz: 'kopiuj-obraz',
      portainer: 'd-portainer',
    };

    const ROLE_WYKRESY: RoleDiagnostyki = {
      digest: 'wyk-d-digest',
      updated: 'wyk-d-updated',
      restarty: 'wyk-d-restarty',
      zadanie: 'wyk-d-zadanie',
      bladLinia: 'wyk-d-blad-linia',
      blad: 'wyk-d-blad',
      obraz: 'wyk-d-obraz',
      kopiujPs: 'wyk-d-kopiuj-ps',
      kopiujLogs: 'wyk-d-kopiuj-logs',
      kopiujInspect: 'wyk-d-kopiuj-inspect',
      kopiujObraz: 'wyk-d-kopiuj-obraz',
      portainer: 'wyk-d-portainer',
    };

    function wypelnijDiagnostyke(
      kontener: HTMLElement,
      role: RoleDiagnostyki,
      usluga: Service,
    ): void {
      const teraz = Math.floor(Date.now() / 1000);
      const digest = skrotDigest(usluga.image);
      setText(
        kontener,
        `[data-role="${role.digest}"]`,
        digest ?? 'brak digestu (obraz wskazywany tagiem)',
      );
      setText(
        kontener,
        `[data-role="${role.updated}"]`,
        usluga.updated_at
          ? `${odKiedy(usluga.updated_at, teraz)} · ${fmtDateTimeUTC(usluga.updated_at)}`
          : DASH,
      );
      setText(kontener, `[data-role="${role.restarty}"]`, opisRestartow(usluga.restarts_1h));

      const zadanie = opisZadania(usluga.last_task_state, usluga.last_task_error);
      setText(kontener, `[data-role="${role.zadanie}"]`, zadanie.tekst);
      setState(kontener, `[data-role="${role.zadanie}"]`, zadanie.stan);

      const liniaBledu = q<HTMLElement>(kontener, `[data-role="${role.bladLinia}"]`);
      if (liniaBledu) liniaBledu.hidden = zadanie.szczegol === null;
      if (zadanie.szczegol !== null) {
        setText(kontener, `[data-role="${role.blad}"]`, zadanie.szczegol);
      }

      setText(kontener, `[data-role="${role.obraz}"]`, obrazBezDigestu(usluga.image));

      const komendy = komendyDocker(usluga.full_name);
      const przyciski: Array<[string, string]> = [
        [role.kopiujPs, komendy[0]?.komenda ?? ''],
        [role.kopiujLogs, komendy[1]?.komenda ?? ''],
        [role.kopiujInspect, komendy[2]?.komenda ?? ''],
      ];
      for (const [rola, komenda] of przyciski) {
        const przycisk = q<HTMLButtonElement>(kontener, `[data-role="${rola}"]`);
        if (!przycisk) continue;
        przycisk.dataset.kopiuj = komenda;
        przycisk.disabled = komenda.length === 0;
        przycisk.title = komenda || 'brak nazwy usługi w API';
      }
      const kopiujObraz = q<HTMLButtonElement>(kontener, `[data-role="${role.kopiujObraz}"]`);
      if (kopiujObraz) {
        kopiujObraz.dataset.kopiuj = usluga.image ?? '';
        kopiujObraz.disabled = !usluga.image;
      }

      const portainer = linkPortainer(
        snapshot?.tools.find((narzedzie) => narzedzie.id === 'portainer')?.url ?? null,
        usluga.full_name,
      );
      const link = q<HTMLAnchorElement>(kontener, `[data-role="${role.portainer}"]`);
      if (link) {
        if (portainer) {
          link.href = portainer;
          link.hidden = false;
        } else {
          link.hidden = true;
        }
      }
    }

    function zbudujSzczegoly(stack: Stack, service: Service): HTMLElement | null {
      const row = instantiate('tpl-service-detail');
      if (!row) return null;
      row.dataset.stack = stack.name;
      row.dataset.usluga = service.name;

      const pelna = service.full_name ?? service.name;
      setTextWithTitle(row, '[data-role="d-usluga"]', pelna);
      setTextWithTitle(row, '[data-role="d-kontener"]', pelna);
      const obraz = service.image ?? '';
      setText(row, '[data-role="d-obraz"]', obraz || DASH);
      const komorkaObrazu = q<HTMLElement>(row, '[data-role="d-obraz"]');
      if (komorkaObrazu) {
        if (obraz) komorkaObrazu.title = obraz;
        else komorkaObrazu.removeAttribute('title');
      }
      setText(
        row,
        '[data-role="d-repliki"]',
        service.replicas_text ?? `${service.running ?? DASH}/${service.desired ?? DASH}`,
      );
      setText(
        row,
        '[data-role="d-cpu"]',
        service.cpu_percent === null ? DASH : fmtPercent(service.cpu_percent),
      );
      setText(row, '[data-role="d-ram"]', fmtBytes(service.mem_bytes));
      setText(row, '[data-role="d-restarty"]', fmtInt(service.restarts_1h));

      wypelnijDiagnostyke(row, ROLE_STATUS, service);

      for (const [rola, tekst] of [
        ['kopiuj-usluga', pelna],
        ['kopiuj-kontener', pelna],
        ['kopiuj-obraz', obraz],
      ] as Array<[string, string]>) {
        const przycisk = q<HTMLButtonElement>(row, `[data-role="${rola}"]`);
        if (!przycisk) continue;
        przycisk.dataset.kopiuj = tekst;
        przycisk.disabled = tekst.length === 0;
      }

      /*
       * Deep-linki do narzędzi z gotowymi zmiennymi dashboardów (`var-*`).
       * Wszystkie adresy są WZGLĘDNE — ten sam origin, jedno logowanie i zero
       * poświadczeń w URL.
       */
      const stackQ = encodeURIComponent(stack.name);
      const uslugaQ = encodeURIComponent(service.name);
      ustawLink(row, 'd-link-wykresy', `/grafana/d/vps-ruch?var-stack=${stackQ}&var-usluga=${uslugaQ}&kiosk`);
      ustawLink(
        row,
        'd-link-aplikacje',
        `/grafana/d/vps-applications?var-stack=${stackQ}&var-service=${uslugaQ}&kiosk`,
      );
      ustawLink(row, 'd-link-logi', `/grafana/d/vps-logs?var-stack=${stackQ}&var-service=${uslugaQ}&kiosk`);
      const zapytanie = `swarm_container_cpu_percent{stack="${stack.name}", service="${service.name}"}`;
      ustawLink(
        row,
        'd-link-prometheus',
        `/prometheus/graph?g0.expr=${encodeURIComponent(zapytanie)}&g0.tab=0`,
      );

      void pokazPrzebieg(row, stack.name, service.name);
      return row;
    }

    async function pobierzPrzebieg(
      stack: string,
      usluga: string,
    ): Promise<{ cpu: number[]; ram: number[] } | null> {
      const klucz = kluczFokusa(stack, usluga);
      const zapisane = przebiegi.get(klucz);
      if (zapisane) return zapisane;

      const koniec = Math.floor(Date.now() / 1000);
      const poczatek = koniec - 6 * 3600;
      const seria = async (expr: string): Promise<number[]> => {
        const url = `/prometheus/api/v1/query_range?query=${encodeURIComponent(expr)}&start=${poczatek}&end=${koniec}&step=300`;
        const odpowiedz = await fetchWithTimeout(url);
        if (!odpowiedz.ok) throw new Error(`HTTP ${odpowiedz.status}`);
        const dane = (await odpowiedz.json()) as {
          data?: { result?: Array<{ values?: Array<[number, string]> }> };
        };
        const punkty = dane.data?.result?.[0]?.values ?? [];
        return punkty.map(([, wartosc]) => Number(wartosc)).filter((v) => Number.isFinite(v));
      };

      try {
        const [cpu, ram] = await Promise.all([
          seria(`sum(swarm_container_cpu_percent{stack="${stack}", service="${usluga}"})`),
          seria(`sum(swarm_container_memory_bytes{stack="${stack}", service="${usluga}"})`),
        ]);
        const wynik = { cpu, ram };
        przebiegi.set(klucz, wynik);
        return wynik;
      } catch {
        // Brak Prometheusa nie może psuć panelu — szczegóły pokażą komunikat.
        return null;
      }
    }

    async function pokazPrzebieg(row: HTMLElement, stack: string, usluga: string): Promise<void> {
      const opis = q<HTMLElement>(row, '[data-role="d-wykres-opis"]');
      const liniaCpu = q<SVGElement>(row, '[data-role="d-spark-cpu"]');
      const liniaRam = q<SVGElement>(row, '[data-role="d-spark-ram"]');
      const dane = await pobierzPrzebieg(stack, usluga);
      // Wiersz mógł zniknąć (zwinięcie stacka, zmiana filtra) — wtedy nic nie rób.
      if (!row.isConnected) return;
      if (!dane || (dane.cpu.length === 0 && dane.ram.length === 0)) {
        if (opis) opis.textContent = 'Brak przebiegu w Prometheusie dla tej usługi (6 h).';
        return;
      }
      if (liniaCpu) liniaCpu.setAttribute('points', punktySparkline(dane.cpu, 300, 40, { min: 0, max: 100 }));
      if (liniaRam) liniaRam.setAttribute('points', punktySparkline(dane.ram, 300, 40));
      if (opis) {
        const maksCpu = dane.cpu.length > 0 ? Math.max(...dane.cpu) : null;
        const ostatniRam = dane.ram.length > 0 ? dane.ram[dane.ram.length - 1] : null;
        opis.textContent = `6 h · CPU maks. ${fmtPercent(maksCpu)} · RAM teraz ${fmtBytes(ostatniRam)}`;
      }
    }

    /* ---------------- widok wykresów (własny, bez ramki Grafany) ---------------- */

    /**
     * Jedno pobranie = komplet serii dla całego widoku: siedem metryk usług
     * (`sum by (stack, service)`) i dziewięć metryk VPS-a. Zapytanie per usługa
     * oznaczałoby ~200 żądań na wejście, a przy odświeżaniu co 10 s — lawinę.
     */
    interface ZbiorSerii {
      kiedy: number;
      /** id metryki → klucz `stack/usługa` → wartości. */
      uslugi: Map<string, Map<string, number[]>>;
      /** id metryki → klucz → znaczniki czasu (tooltip musi znać czas punktu). */
      czasyUslug: Map<string, Map<string, number[]>>;
      /** id metryki VPS-a → jedna seria (node-exporter ma jeden host). */
      vps: Map<string, { wartosci: number[]; czasy: number[] }>;
    }

    interface SeriaRysowana {
      nazwa: string;
      wartosci: number[];
      czasy: number[];
    }

    /** Wszystko, czego potrzebuje tooltip — trzymane per figura w DOM. */
    interface WykresRysowany {
      tytul: string;
      jednostka: (wartosc: number | null, miejsca?: number) => string;
      /**
       * Ile jednostek surowych to jedna jednostka wyświetlana (GiB = 2³⁰,
       * MiB/s = 2²⁰, % = 1). Dzięki temu „ładny" krok liczymy w jednostkach,
       * które widać na osi: RAM dostaje 17/19/21/23 GiB, a nie 17/19/20/22 GiB.
       */
      skala?: number;
      serie: SeriaRysowana[];
      granice: Granice;
      limit: number[] | null;
      zakres: Zakres;
      podmiot: string | null;
    }

    interface OpisWykresu {
      tytul: string;
      liczby: string;
      statystyki?: string;
      serie: Array<{ rola: 'wyk-linia' | 'wyk-linia2'; nazwa: string; wartosci: number[]; czasy: number[] }>;
      limit: number[] | null;
      granice: Granice;
      jednostka: (wartosc: number | null, miejsca?: number) => string;
      /**
       * Ile jednostek surowych to jedna jednostka wyświetlana (GiB = 2³⁰,
       * MiB/s = 2²⁰, % = 1). Dzięki temu „ładny" krok liczymy w jednostkach,
       * które widać na osi: RAM dostaje 17/19/21/23 GiB, a nie 17/19/20/22 GiB.
       */
      skala?: number;
      aria: string;
    }

    interface PromZakres {
      data?: {
        result?: Array<{ metric?: Record<string, string>; values?: Array<[number, string]> }>;
      };
    }

    const serieCache = new Map<ZakresId, ZbiorSerii>();
    /** Sygnatura tego, co narysowane — przebudowa DOM tylko przy realnej zmianie. */
    let sygnaturaWykresow = '';
    /** Cache „na wejściu" może być długi; przy cyklu 5–10 s musi być krótszy niż interwał. */
    const TTL_CACHE_MS = 60_000;
    const TTL_SWIEZE_MS = 2_000;
    /** Dane narysowanych figur i bieżący indeks tooltipa (klawiatura, odświeżanie). */
    const daneWykresow = new Map<HTMLElement, WykresRysowany>();
    const indeksyTooltipow = new Map<HTMLElement, number>();
    let timerWykresow: number | null = null;

    async function pobierzZbior(zakres: Zakres, swieze = false): Promise<ZbiorSerii | null> {
      const zapisane = serieCache.get(zakres.id);
      const ttl = swieze ? TTL_SWIEZE_MS : TTL_CACHE_MS;
      if (zapisane && Date.now() - zapisane.kiedy < ttl) return zapisane;

      const teraz = Math.floor(Date.now() / 1000);
      const zbior: ZbiorSerii = {
        kiedy: Date.now(),
        uslugi: new Map(),
        czasyUslug: new Map(),
        vps: new Map(),
      };
      try {
        await Promise.all([
          ...zapytaniaZbiorcze().map(async (zapytanie) => {
            const odpowiedz = await fetchWithTimeout(
              zbudujUrlQueryRange(zapytanie.expr, zakres, teraz),
            );
            if (!odpowiedz.ok) throw new Error(`HTTP ${odpowiedz.status}`);
            const dane = (await odpowiedz.json()) as PromZakres;
            const mapa = new Map<string, number[]>();
            const mapaCzasow = new Map<string, number[]>();
            for (const seria of dane.data?.result ?? []) {
              const stack = seria.metric?.stack ?? '';
              const usluga = seria.metric?.service ?? '';
              if (!stack || !usluga) continue;
              const punkty = (seria.values ?? []).filter((punkt) =>
                Number.isFinite(Number(punkt[1])),
              );
              const klucz = kluczSerii(stack, usluga);
              mapa.set(klucz, punkty.map(([, wartosc]) => Number(wartosc)));
              mapaCzasow.set(klucz, punkty.map(([chwila]) => Number(chwila)));
            }
            zbior.uslugi.set(zapytanie.id, mapa);
            zbior.czasyUslug.set(zapytanie.id, mapaCzasow);
          }),
          ...zapytaniaVps().map(async (zapytanie) => {
            const odpowiedz = await fetchWithTimeout(
              zbudujUrlQueryRange(zapytanie.expr, zakres, teraz),
            );
            if (!odpowiedz.ok) throw new Error(`HTTP ${odpowiedz.status}`);
            const dane = (await odpowiedz.json()) as PromZakres;
            const punkty = (dane.data?.result?.[0]?.values ?? []).filter((punkt) =>
              Number.isFinite(Number(punkt[1])),
            );
            zbior.vps.set(zapytanie.id, {
              wartosci: punkty.map(([, wartosc]) => Number(wartosc)),
              czasy: punkty.map(([chwila]) => Number(chwila)),
            });
          }),
        ]);
      } catch {
        // Brak Prometheusa nie może psuć panelu — mówimy to wprost pod nagłówkiem.
        return null;
      }
      serieCache.set(zakres.id, zbior);
      return zbior;
    }

    /** Seria usługi (wartości + czasy) albo pusta, gdy Prometheus jej nie oddał. */
    function seriaZ(
      zbior: ZbiorSerii | null,
      id: string,
      stack: string,
      usluga: string,
    ): { wartosci: number[]; czasy: number[] } {
      const klucz = kluczSerii(stack, usluga);
      return {
        wartosci: zbior?.uslugi.get(id)?.get(klucz) ?? [],
        czasy: zbior?.czasyUslug.get(id)?.get(klucz) ?? [],
      };
    }

    function seriaVps(zbior: ZbiorSerii | null, id: string): { wartosci: number[]; czasy: number[] } {
      return zbior?.vps.get(id) ?? { wartosci: [], czasy: [] };
    }

    /** Ostatnia wartość serii jako liczba (albo `null`, gdy seria pusta). */
    function ostatniaWartosc(seria: { wartosci: number[] }): number | null {
      const ostatnia = seria.wartosci[seria.wartosci.length - 1];
      return czyLiczba(ostatnia) ? ostatnia : null;
    }

    /**
     * Wykresy CAŁEGO VPS-a: CPU, RAM (z linią całości), sieć rx/tx, dysk
     * (z linią pojemności) i obciążenie (z linią liczby rdzeni).
     */
    function opisWykresowVps(zbior: ZbiorSerii | null, zakres: Zakres): OpisWykresu[] {
      const cpu = seriaVps(zbior, 'vps_cpu');
      const ram = seriaVps(zbior, 'vps_ram');
      const rx = seriaVps(zbior, 'vps_rx');
      const tx = seriaVps(zbior, 'vps_tx');
      const fs = seriaVps(zbior, 'vps_fs');
      const load = seriaVps(zbior, 'vps_load');
      const ramTotal = ostatniaWartosc(seriaVps(zbior, 'vps_ram_total'));
      const fsTotal = ostatniaWartosc(seriaVps(zbior, 'vps_fs_total'));
      const rdzenie = ostatniaWartosc(seriaVps(zbior, 'vps_rdzenie'));
      const podmiot = null;
      const stCpu = statystyki(cpu.wartosci);
      const stRam = statystyki(ram.wartosci);
      const stRx = statystyki(rx.wartosci);
      const stTx = statystyki(tx.wartosci);
      const stFs = statystyki(fs.wartosci);
      const stLoad = statystyki(load.wartosci);

      return [
        {
          tytul: tytulWykresu('CPU', podmiot),
          liczby: `${formatujProcent(stCpu.teraz, 1)} · maks. ${formatujProcent(stCpu.maks, 1)}`,
          statystyki: `średnia ${formatujProcent(stCpu.srednia, 1)} · ${podpisZakresu(zakres)}`,
          serie: [{ rola: 'wyk-linia', nazwa: 'CPU', ...cpu }],
          limit: null,
          granice: graniceWykresu(cpu.wartosci, { odZera: true }),
          jednostka: (v, m) => formatujProcent(v, m ?? 0),
          aria: `Zużycie CPU całego VPS-a: teraz ${formatujProcent(stCpu.teraz, 1)}, maksimum ${formatujProcent(stCpu.maks, 1)}`,
        },
        {
          tytul: tytulWykresu('RAM', podmiot),
          liczby: `${formatujBajty(stRam.teraz)}${ramTotal === null ? '' : ` / ${formatujBajty(ramTotal)}`}`
            + `${ramTotal && czyLiczba(stRam.teraz) ? ` · ${formatujProcent((stRam.teraz / ramTotal) * 100, 1)}` : ''}`,
          statystyki: `maks. ${formatujBajty(stRam.maks)} · średnia ${formatujBajty(stRam.srednia)}`,
          serie: [{ rola: 'wyk-linia', nazwa: 'RAM użyta', ...ram }],
          limit: ramTotal === null ? null : [ramTotal, ramTotal],
          granice: graniceWykresu([...ram.wartosci, ...(ramTotal === null ? [] : [ramTotal])]),
          jednostka: (v, m) => formatujBajty(v, m ?? 0),
          skala: 1024 ** 3,
          aria: `Pamięć VPS-a: teraz ${formatujBajty(stRam.teraz)}, maksimum ${formatujBajty(stRam.maks)}`,
        },
        {
          tytul: tytulWykresu('Sieć (rx / tx)', podmiot),
          liczby: `rx ${formatujPrzeplywnosc(stRx.teraz)} · tx ${formatujPrzeplywnosc(stTx.teraz)}`,
          statystyki: `maks. rx ${formatujPrzeplywnosc(stRx.maks)} · maks. tx ${formatujPrzeplywnosc(stTx.maks)}`,
          serie: [
            { rola: 'wyk-linia', nazwa: 'rx (odbiór)', ...rx },
            { rola: 'wyk-linia2', nazwa: 'tx (wysyłka)', ...tx },
          ],
          limit: null,
          granice: graniceWykresu([...rx.wartosci, ...tx.wartosci], { odZera: true }),
          jednostka: (v, m) => formatujPrzeplywnosc(v, m ?? 0),
          skala: 1024 ** 2,
          aria: `Ruch sieciowy VPS-a: odbiór ${formatujPrzeplywnosc(stRx.teraz)}, wysyłka ${formatujPrzeplywnosc(stTx.teraz)}`,
        },
        {
          tytul: tytulWykresu('Dysk (zajęte)', podmiot),
          liczby: `${formatujBajty(stFs.teraz)}${fsTotal === null ? '' : ` / ${formatujBajty(fsTotal)}`}`
            + `${fsTotal && czyLiczba(stFs.teraz) ? ` · ${formatujProcent((stFs.teraz / fsTotal) * 100, 1)}` : ''}`,
          statystyki: `maks. ${formatujBajty(stFs.maks)} · partycja /`,
          serie: [{ rola: 'wyk-linia', nazwa: 'zajęte', ...fs }],
          limit: fsTotal === null ? null : [fsTotal, fsTotal],
          granice: graniceWykresu([...fs.wartosci, ...(fsTotal === null ? [] : [fsTotal])]),
          jednostka: (v, m) => formatujBajty(v, m ?? 0),
          skala: 1024 ** 3,
          aria: `Zajęte miejsce na partycji głównej: teraz ${formatujBajty(stFs.teraz)}`,
        },
        {
          tytul: tytulWykresu('Obciążenie (load1)', podmiot),
          liczby: `${formatujLiczbe(stLoad.teraz)}${rdzenie === null ? '' : ` / ${formatujLiczbe(rdzenie, 0)} rdzeni`}`,
          statystyki: `maks. ${formatujLiczbe(stLoad.maks)} · średnia ${formatujLiczbe(stLoad.srednia)}`,
          serie: [{ rola: 'wyk-linia', nazwa: 'load1', ...load }],
          limit: rdzenie === null ? null : [rdzenie, rdzenie],
          granice: graniceWykresu([...load.wartosci, ...(rdzenie === null ? [] : [rdzenie])], { odZera: true }),
          jednostka: (v, m) => formatujLiczbe(v, m ?? 2),
          aria: `Obciążenie VPS-a: teraz ${formatujLiczbe(stLoad.teraz)}, maksimum ${formatujLiczbe(stLoad.maks)}`,
        },
      ];
    }

    /**
     * Wykresy jednej usługi. `skrocony` (tryb „wszystkie usługi") rysuje tylko
     * CPU i RAM — inaczej lista 47 usług razy cztery wykresy odświeżana co 10 s
     * byłaby ciężka i nieczytelna.
     */
    function opisWykresowUslugi(
      usluga: Service,
      stack: string,
      zbior: ZbiorSerii | null,
      zakres: Zakres,
      skrocony = false,
    ): OpisWykresu[] {
      const podpisZakresuTekst = podpisZakresu(zakres);
      const cpu = seriaZ(zbior, 'cpu', stack, usluga.name);
      const ram = seriaZ(zbior, 'ram', stack, usluga.name);
      const limitSerii = seriaZ(zbior, 'limit', stack, usluga.name);
      const limitZMetrki = ostatniaWartosc(limitSerii);
      const limitZApi = usluga.mem_limit_bytes;
      const limit = czyLiczba(limitZApi) && limitZApi > 0
        ? limitZApi
        : (limitZMetrki !== null && limitZMetrki > 0 ? limitZMetrki : null);
      const limitCpu = usluga.cpu_limit_cores ?? null;
      const limitCpuProc = limitCpuProcent(limitCpu);
      const podmiot = kluczSerii(stack, usluga.name);

      const stCpu = statystyki(cpu.wartosci);
      const stRam = statystyki(ram.wartosci);
      const terazCpu = usluga.cpu_percent ?? stCpu.teraz;
      const terazRam = usluga.mem_bytes ?? stRam.teraz;

      const wykresy: OpisWykresu[] = [
        {
          tytul: tytulWykresu('CPU', podmiot),
          liczby: opisCpu(terazCpu, limitCpu, stCpu.maks),
          statystyki: `${statystykiCpu(stCpu, limitCpu, terazCpu)} · ${podpisZakresuTekst}`,
          serie: [{ rola: 'wyk-linia', nazwa: 'CPU', ...cpu }],
          limit: limitCpuProc === null ? null : [limitCpuProc, limitCpuProc],
          granice: graniceWykresu(
            [...cpu.wartosci, ...(limitCpuProc === null ? [] : [limitCpuProc])],
            { odZera: true },
          ),
          jednostka: (v, m) => formatujProcent(v, m ?? 1),
          aria: `Zużycie CPU usługi ${usluga.name}: teraz ${formatujProcent(terazCpu, 1)}, maksimum ${formatujProcent(stCpu.maks, 1)}`,
        },
        {
          tytul: tytulWykresu('RAM', podmiot),
          liczby: opisRam(terazRam, limit, stRam.maks),
          statystyki: `${statystykiRam(stRam, limit, terazRam)} · ${podpisZakresuTekst}`,
          serie: [{ rola: 'wyk-linia', nazwa: 'RAM', ...ram }],
          limit: limit === null ? null : [limit, limit],
          granice: graniceWykresu([...ram.wartosci, ...(limit === null ? [] : [limit])]),
          jednostka: (v, m) => formatujBajty(v, m ?? 0),
          skala: 1024 ** 3,
          aria: `Zużycie pamięci usługi ${usluga.name}: teraz ${formatujBajty(terazRam)}, limit ${limit === null ? 'nieustawiony' : formatujBajty(limit)}`,
        },
      ];
      if (skrocony) return wykresy;

      const rx = seriaZ(zbior, 'rx', stack, usluga.name);
      const tx = seriaZ(zbior, 'tx', stack, usluga.name);
      const ioR = seriaZ(zbior, 'io_r', stack, usluga.name);
      const ioW = seriaZ(zbior, 'io_w', stack, usluga.name);
      const stRx = statystyki(rx.wartosci);
      const stTx = statystyki(tx.wartosci);
      const stIoR = statystyki(ioR.wartosci);
      const stIoW = statystyki(ioW.wartosci);

      wykresy.push(
        {
          tytul: tytulWykresu('Sieć (rx / tx)', podmiot),
          liczby: opisSieci(stRx.teraz, stTx.teraz, stRx.maks),
          statystyki: statystykiSieci(stRx, stTx),
          serie: [
            { rola: 'wyk-linia', nazwa: 'rx (odbiór)', ...rx },
            { rola: 'wyk-linia2', nazwa: 'tx (wysyłka)', ...tx },
          ],
          limit: null,
          granice: graniceWykresu([...rx.wartosci, ...tx.wartosci], { odZera: true }),
          jednostka: (v, m) => formatujPrzeplywnosc(v, m ?? 0),
          skala: 1024 ** 2,
          aria: `Ruch sieciowy usługi ${usluga.name}: odbiór ${formatujPrzeplywnosc(stRx.teraz)}, wysyłka ${formatujPrzeplywnosc(stTx.teraz)}`,
        },
        {
          tytul: tytulWykresu('Dysk (odczyt / zapis)', podmiot),
          liczby: opisDysku(stIoR.teraz, stIoW.teraz, stIoR.maks),
          statystyki: statystykiDysku(stIoR, stIoW),
          serie: [
            { rola: 'wyk-linia', nazwa: 'odczyt', ...ioR },
            { rola: 'wyk-linia2', nazwa: 'zapis', ...ioW },
          ],
          limit: null,
          granice: graniceWykresu([...ioR.wartosci, ...ioW.wartosci], { odZera: true }),
          jednostka: (v, m) => formatujPrzeplywnosc(v, m ?? 0),
          skala: 1024 ** 2,
          aria: `Wejście i wyjście dysku usługi ${usluga.name}: odczyt ${formatujPrzeplywnosc(stIoR.teraz)}, zapis ${formatujPrzeplywnosc(stIoW.teraz)}`,
        },
      );
      return wykresy;
    }

    function wspolrzednaY(
      wartosc: number,
      granice: Granice,
      wysokosc: number,
      margines: number,
    ): number {
      const uzyteczna = Math.max(1, wysokosc - 2 * margines);
      const rozstep = granice.max - granice.min || 1;
      const udzial = (wartosc - granice.min) / rozstep;
      return margines + (1 - Math.min(1, Math.max(0, udzial))) * uzyteczna;
    }

    function ustawLinie(
      figura: HTMLElement,
      rola: string,
      wartosci: readonly number[],
      granice: Granice,
      szerokosc: number,
      wysokosc: number,
      margines: number,
    ): void {
      const linia = q<SVGElement>(figura, `[data-role="${rola}"]`);
      if (!linia) return;
      if (wartosci.length === 0) {
        linia.setAttribute('points', '');
        linia.style.display = 'none';
        return;
      }
      linia.style.display = '';
      linia.setAttribute(
        'points',
        punktyWykresu(wartosci, szerokosc, wysokosc, granice, { margines }),
      );
    }

    /**
     * Rysowanie w istniejącym DOM (jedno miejsce dla wszystkich trybów).
     * Aktualizuje wyłącznie atrybuty i tekst, więc odświeżanie co 5–10 s nie
     * przebudowuje listy i nie przewraca przewijania.
     */
    function rysujWykres(figura: HTMLElement, opis: OpisWykresu, zakres: Zakres, podmiot: string | null): void {
      const szerokosc = WYKRES_SZEROKOSC;
      const wysokosc = WYKRES_WYSOKOSC;
      const margines = WYKRES_MARGINES;
      const skala = opis.skala && opis.skala > 0 ? opis.skala : 1;
      const ticki = osieY(
        { min: opis.granice.min / skala, max: opis.granice.max / skala },
        WYKRES_LINIE,
      ).map((tick) => tick * skala);

      const siatki = q<SVGGElement>(figura, '[data-role="wyk-siatki"]');
      if (siatki) {
        const linie = ticki.map((tick) => {
          const y = wspolrzednaY(tick, opis.granice, wysokosc, margines);
          const linia = document.createElementNS('http://www.w3.org/2000/svg', 'line');
          linia.setAttribute('class', 'wykres-siatka');
          linia.setAttribute('x1', '0');
          linia.setAttribute('x2', String(szerokosc));
          linia.setAttribute('y1', y.toFixed(2));
          linia.setAttribute('y2', y.toFixed(2));
          return linia;
        });
        siatki.replaceChildren(...linie);
      }

      for (const seria of opis.serie) {
        ustawLinie(figura, seria.rola, seria.wartosci, opis.granice, szerokosc, wysokosc, margines);
      }
      ustawLinie(figura, 'wyk-limit', opis.limit ?? [], opis.granice, szerokosc, wysokosc, margines);

      // Etykiety Y stoją DOKŁADNIE na swoich liniach (w procentach wysokości),
      // więc liczba na wykresie i liczba na osi nie mogą się rozjechać.
      const osieYElement = q<HTMLElement>(figura, '[data-role="wyk-osie-y"]');
      if (osieYElement) {
        const krok =
          ticki.length > 1 ? Math.abs((ticki[0] as number) - (ticki[1] as number)) / skala : 0;
        const miejsca = dokladnoscOsi(krok);
        const etykiety = ticki.map((tick) => {
          const y = wspolrzednaY(tick, opis.granice, wysokosc, margines);
          const pole = document.createElement('span');
          pole.className = 'wykres-os-y num';
          pole.style.top = `${((y / wysokosc) * 100).toFixed(3)}%`;
          pole.textContent = opis.jednostka(tick, miejsca);
          return pole;
        });
        osieYElement.replaceChildren(...etykiety);
      }

      setText(figura, '[data-role="wyk-tytul"]', opis.tytul);
      setText(figura, '[data-role="wyk-liczby"]', opis.liczby);
      if (opis.statystyki !== undefined) {
        setText(figura, '[data-role="wyk-statystyki"]', opis.statystyki);
      }
      rysujOsX(figura, opis, zakres);

      daneWykresow.set(figura, {
        tytul: opis.tytul,
        jednostka: opis.jednostka,
        serie: opis.serie.map((seria) => ({
          nazwa: seria.nazwa,
          wartosci: seria.wartosci,
          czasy: seria.czasy,
        })),
        granice: opis.granice,
        limit: opis.limit,
        zakres,
        podmiot,
      });
      const svg = q<SVGElement>(figura, '[data-role="wyk-svg"]');
      if (svg) svg.setAttribute('aria-label', opis.aria);
      ukryjTooltip(figura);
    }

    /**
     * Etykiety osi czasu. Liczymy je z realnej szerokości karty (nie z viewBoxu),
     * bo na 13-calowym laptopie karta ma ~600 px i zmieści 4 etykiety, a na
     * szerokim ekranie 5 — bez nachodzenia i bez wychodzenia z karty.
     */
    function rysujOsX(figura: HTMLElement, opis: OpisWykresu, zakres: Zakres): void {
      const pole = q<HTMLElement>(figura, '[data-role="wyk-osie-x"]');
      const plot = q<HTMLElement>(figura, '[data-role="wyk-plot"]');
      if (!pole) return;
      const serie = opis.serie.filter((seria) => seria.czasy.length > 0);
      const czasy = serie.flatMap((seria) => seria.czasy).filter(czyLiczba);
      if (czasy.length === 0) {
        pole.replaceChildren();
        return;
      }
      const od = Math.min(...czasy);
      const doTeraz = Math.max(...czasy);
      const szerokoscPx = plot?.clientWidth || WYKRES_SZEROKOSC;
      const etykiety = etykietyOsiX(zakres, od, doTeraz, szerokoscPx);
      const elementy = etykiety.map((etykieta) => {
        const span = document.createElement('span');
        span.className = 'wykres-os-x num';
        span.style.left = `${(etykieta.udzial * 100).toFixed(3)}%`;
        // Pierwsza etykieta wyrównana do lewej, ostatnia do prawej — inaczej
        // wystają poza kartę (zmierzone: „24.09 07:34” uciekało za krawędź).
        if (etykieta.udzial === 0) span.dataset.krawedz = 'start';
        else if (etykieta.udzial === 1) span.dataset.krawedz = 'koniec';
        span.textContent = etykieta.tekst;
        return span;
      });
      pole.replaceChildren(...elementy);
    }

    /* ---------------- tooltip: mysz i klawiatura ---------------- */

    function ukryjTooltip(figura: HTMLElement): void {
      indeksyTooltipow.delete(figura);
      const tooltip = q<HTMLElement>(figura, '[data-role="wyk-tooltip"]');
      if (tooltip) tooltip.hidden = true;
      const kursor = q<SVGElement>(figura, '[data-role="wyk-kursor"]');
      if (kursor) kursor.style.display = 'none';
      for (const rola of ['wyk-kropka', 'wyk-kropka2']) {
        const kropka = q<HTMLElement>(figura, `[data-role="${rola}"]`);
        if (kropka) kropka.hidden = true;
      }
    }

    function pokazTooltip(figura: HTMLElement, indeks: number): void {
      const dane = daneWykresow.get(figura);
      if (!dane) return;
      const serie = dane.serie.filter((s) => s.wartosci.length > 0);
      const ile = Math.max(...serie.map((s) => s.wartosci.length), 0);
      if (ile === 0) return;
      const pozycja = Math.min(Math.max(0, indeks), ile - 1);
      indeksyTooltipow.set(figura, pozycja);

      const szerokosc = WYKRES_SZEROKOSC;
      const wysokosc = WYKRES_WYSOKOSC;
      const margines = WYKRES_MARGINES;
      const x = ile === 1 ? 0 : (pozycja * szerokosc) / (ile - 1);

      const kursor = q<SVGLineElement>(figura, '[data-role="wyk-kursor"]');
      if (kursor) {
        kursor.style.display = '';
        kursor.setAttribute('x1', x.toFixed(2));
        kursor.setAttribute('x2', x.toFixed(2));
        kursor.setAttribute('y1', '0');
        kursor.setAttribute('y2', String(wysokosc));
      }

      // Kropki na każdej linii — dzięki temu widać, którą serię czytamy.
      // Pozycja w pikselach CSS, bo SVG rozciąga się w poziomie (kropka rysowana
      // w SVG stawała się elipsą).
      const plotKropek = q<HTMLElement>(figura, '[data-role="wyk-plot"]');
      const szerokoscKropek = plotKropek?.clientWidth || szerokosc;
      const wysokoscKropek = plotKropek?.clientHeight || wysokosc;
      let indeksKropki = 0;
      for (const rysowana of dane.serie) {
        const element = q<HTMLElement>(
          figura,
          `[data-role="${indeksKropki === 0 ? 'wyk-kropka' : 'wyk-kropka2'}"]`,
        );
        indeksKropki += 1;
        if (!element) continue;
        const wartosc = rysowana.wartosci[pozycja];
        if (rysowana.wartosci.length === 0 || !czyLiczba(wartosc)) {
          element.hidden = true;
          continue;
        }
        element.hidden = false;
        element.style.left = `${((x / szerokosc) * szerokoscKropek).toFixed(1)}px`;
        element.style.top = `${(
          (wspolrzednaY(wartosc, dane.granice, wysokosc, margines) / wysokosc) *
          wysokoscKropek
        ).toFixed(1)}px`;
      }

      const pierwszaSeria = serie[0];
      const czasy = pierwszaSeria?.czasy ?? [];
      const chwila = czasy[pozycja];
      setText(
        figura,
        '[data-role="wyk-tooltip-czas"]',
        czyLiczba(chwila) ? etykietaPunktu(chwila, dane.zakres) : '',
      );

      const wiersze = wierszeTooltipa(
        dane.serie.map((s) => ({ nazwa: s.nazwa, wartosci: s.wartosci })),
        pozycja,
        dane.jednostka,
      );
      const holder = q<HTMLElement>(figura, '[data-role="wyk-tooltip-wiersze"]');
      if (holder) {
        const elementy = wiersze.map((wiersz: WierszTooltipa) => {
          const linia = document.createElement('span');
          linia.className = 'wykres-tooltip-wiersz';
          const nazwa = document.createElement('span');
          nazwa.className = 'wykres-tooltip-nazwa';
          nazwa.textContent = wiersz.nazwa;
          const wartosc = document.createElement('span');
          wartosc.className = 'num';
          wartosc.textContent = wiersz.tekst;
          linia.append(nazwa, wartosc);
          return linia;
        });
        holder.replaceChildren(...elementy);
      }

      const tooltip = q<HTMLElement>(figura, '[data-role="wyk-tooltip"]');
      const plot = q<HTMLElement>(figura, '[data-role="wyk-plot"]');
      if (tooltip && plot) {
        tooltip.hidden = false;
        // Pozycja w pikselach CSS: wykres skaluje się do szerokości karty,
        // więc przeliczamy udział punktu na rzeczywistą szerokość.
        const udzial = x / szerokosc;
        const szerokoscPx = plot.clientWidth;
        tooltip.style.left = `${Math.min(Math.max(0, udzial * szerokoscPx), szerokoscPx)}px`;
      }
    }

    /** Najbliższy punkt dla pozycji kursora (spójnie z rysowaniem linii). */
    function pokazTooltipZPozycji(figura: HTMLElement, klientX: number): void {
      const plot = q<HTMLElement>(figura, '[data-role="wyk-plot"]');
      const dane = daneWykresow.get(figura);
      if (!plot || !dane) return;
      const ile = Math.max(...dane.serie.map((s) => s.wartosci.length), 0);
      const prostokat = plot.getBoundingClientRect();
      if (prostokat.width <= 0) return;
      const udzial = (klientX - prostokat.left) / prostokat.width;
      const indeks = indeksNajblizszy(udzial * WYKRES_SZEROKOSC, WYKRES_SZEROKOSC, ile);
      if (indeks === null) return;
      pokazTooltip(figura, indeks);
    }

    function figuraZ(event: Event): HTMLElement | null {
      const cel = event.target;
      if (!(cel instanceof Element)) return null;
      return cel.closest<HTMLElement>('[data-role="wyk-figura"]');
    }

    function podlaczTooltipy(kontener: HTMLElement): void {
      let ostatniaFigura: HTMLElement | null = null;
      kontener.addEventListener('pointermove', (event) => {
        const figura = figuraZ(event);
        if (figura !== ostatniaFigura) {
          if (ostatniaFigura) ukryjTooltip(ostatniaFigura);
          ostatniaFigura = figura;
        }
        if (figura) pokazTooltipZPozycji(figura, event.clientX);
      });
      kontener.addEventListener('pointerleave', () => {
        if (ostatniaFigura) ukryjTooltip(ostatniaFigura);
        ostatniaFigura = null;
      });
      // Klawiatura: Tab wchodzi na wykres, strzałki przesuwają punkt, Esc zamyka.
      kontener.addEventListener('keydown', (event) => {
        const figura = figuraZ(event);
        if (!figura) return;
        if (event.key === 'Escape') {
          ukryjTooltip(figura);
          return;
        }
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        const dane = daneWykresow.get(figura);
        if (!dane) return;
        const ile = Math.max(...dane.serie.map((s) => s.wartosci.length), 0);
        if (ile === 0) return;
        const obecny = indeksyTooltipow.get(figura) ?? ile - 1;
        const nastepny = Math.min(ile - 1, Math.max(0, obecny + (event.key === 'ArrowRight' ? 1 : -1)));
        pokazTooltip(figura, nastepny);
      });
    }

    /* ---------------- budowa i odświeżanie widoku ---------------- */

    function pokazKomunikatWykresow(tekst: string | null): void {
      const komunikat = q<HTMLElement>(app, '[data-role="wykresy-komunikat"]');
      if (!komunikat) return;
      komunikat.hidden = tekst === null;
      komunikat.textContent = tekst ?? '';
    }

    function sekcjaWykresow(
      tytul: string,
      podpis: string,
      klucz: string,
      tryb: 'vps' | 'usluga' | 'lista',
      para?: { stack: Stack; usluga: Service },
      zakres?: Zakres,
    ): HTMLElement | null {
      const sekcja = instantiate('tpl-wykres-sekcja');
      if (!sekcja) return null;
      sekcja.dataset.podmiot = klucz;
      setText(sekcja, '[data-role="wyk-nazwa"]', tytul);
      setText(sekcja, '[data-role="wyk-sekcja-podpis"]', podpis);
      const siatka = q<HTMLElement>(sekcja, '[data-role="wyk-siatka"]');
      if (!siatka) return sekcja;

      const pokazUslugowe = tryb !== 'vps';
      for (const rola of ['wyk-link-stan', 'wyk-szczegoly']) {
        const element = q<HTMLElement>(sekcja, `[data-role="${rola}"]`);
        if (element) element.hidden = !pokazUslugowe;
      }
      const diagnostyka = q<HTMLElement>(sekcja, '[data-role="wyk-diagnostyka"]');
      if (diagnostyka) diagnostyka.hidden = tryb !== 'usluga';

      if (para) {
        const dot = q<HTMLElement>(sekcja, '[data-role="wyk-dot"]');
        if (dot) {
          dot.hidden = false;
          setState(sekcja, '[data-role="wyk-dot"]', para.usluga.state);
        }
        setText(sekcja, '[data-role="wyk-stack"]', para.stack.name);
        const repliki = q<HTMLElement>(sekcja, '[data-role="wyk-repliki"]');
        if (repliki) {
          repliki.hidden = false;
          repliki.textContent = para.usluga.replicas_text
            ?? `${para.usluga.running ?? 0}/${para.usluga.desired ?? 0}`;
        }
        const link = q<HTMLAnchorElement>(sekcja, '[data-role="wyk-link"]');
        if (link && zakres) {
          link.href = doHaszaWykresow(klucz, zakres.id);
          link.title = `Szczegóły wykresów: ${klucz}`;
        }
        const szczegoly = q<HTMLElement>(sekcja, '[data-role="wyk-szczegoly"]');
        if (szczegoly) szczegoly.dataset.usluga = klucz;
        const linkStan = q<HTMLAnchorElement>(sekcja, '[data-role="wyk-link-stan"]');
        if (linkStan) linkStan.href = doHasza(filtr, klucz);
      } else {
        const nazwa = q<HTMLAnchorElement>(sekcja, '[data-role="wyk-link"]');
        if (nazwa) {
          nazwa.removeAttribute('href');
          nazwa.classList.add('row-name-plain');
        }
      }
      return sekcja;
    }

    function zbudujSekcjeWykresow(
      podmiot: string | null,
      pary: ReadonlyArray<{ stack: Stack; usluga: Service }>,
      zakres: Zakres,
    ): void {
      const doWyboru = podmiot === null || podmiot === PODMIOT_WSZYSTKIE
        ? pary
        : (wszystkiePary().length > 0 ? wszystkiePary() : pary);
      const sekcje = q<HTMLElement>(app, '[data-role="wykresy-sekcje"]');
      if (!sekcje) return;
      const czas = etykietyCzasu(zakres, Math.floor(Date.now() / 1000));
      const podpisCzasu = `${czas.od} – ${czas.do} UTC · ${podpisZakresu(zakres)}`;

      if (podmiot === null) {
        const sekcja = sekcjaWykresow(
          'Cały VPS',
          `node-exporter · ${podpisCzasu}`,
          'vps',
          'vps',
        );
        if (!sekcja) return;
        const siatka = q<HTMLElement>(sekcja, '[data-role="wyk-siatka"]');
        const ileFigur = opisWykresowVps(null, zakres).length;
        for (let indeks = 0; indeks < ileFigur; indeks += 1) {
          const figura = instantiate('tpl-wykres');
          if (!figura || !siatka) continue;
          siatka.append(figura);
        }
        sekcje.replaceChildren(sekcja);
        return;
      }

      if (podmiot === PODMIOT_WSZYSTKIE) {
        const elementy: HTMLElement[] = [];
        for (const para of pary) {
          const klucz = kluczSerii(para.stack.name, para.usluga.name);
          const sekcja = sekcjaWykresow(
            para.usluga.name,
            `${para.stack.name} · ${podpisCzasu}`,
            klucz,
            'lista',
            para,
            zakres,
          );
          if (!sekcja) continue;
          const siatka = q<HTMLElement>(sekcja, '[data-role="wyk-siatka"]');
          const opisy = opisWykresowUslugi(para.usluga, para.stack.name, null, zakres, true);
          for (let indeks = 0; indeks < opisy.length; indeks += 1) {
            const figura = instantiate('tpl-wykres');
            if (!figura || !siatka) continue;
            siatka.append(figura);
          }
          elementy.push(sekcja);
        }
        sekcje.replaceChildren(...elementy);
        return;
      }

      const znaleziona = znajdzUsluge(
        doWyboru.map((para) => ({ stack: para.stack.name, usluga: para.usluga })),
        podmiot,
      );
      if (!znaleziona) {
        sekcje.replaceChildren();
        pokazKomunikatWykresow(`Nie znaleziono usługi „${podmiot}" — wybierz ją z listy powyżej.`);
        return;
      }
      const klucz = kluczSerii(znaleziona.stack, znaleziona.usluga.name);
      const para = doWyboru.find((p) => kluczSerii(p.stack.name, p.usluga.name) === klucz);
      if (!para) {
        sekcje.replaceChildren();
        pokazKomunikatWykresow(`Nie znaleziono usługi „${podmiot}" — wybierz ją z listy powyżej.`);
        return;
      }
      const sekcja = sekcjaWykresow(
        para.usluga.name,
        `${para.stack.name} · ${podpisCzasu}`,
        klucz,
        'usluga',
        para,
        zakres,
      );
      if (!sekcja) return;
      const siatka = q<HTMLElement>(sekcja, '[data-role="wyk-siatka"]');
      const ileFigur = opisWykresowUslugi(para.usluga, para.stack.name, null, zakres).length;
      for (let indeks = 0; indeks < ileFigur; indeks += 1) {
        const figura = instantiate('tpl-wykres');
        if (!figura || !siatka) continue;
        siatka.append(figura);
      }
      wypelnijDiagnostyke(sekcja, ROLE_WYKRESY, znaleziona.usluga);
      sekcje.replaceChildren(sekcja);
    }

    /** Wypełnienie/odświeżenie figur bez przebudowy DOM (serce „na żywo"). */
    function wypelnijWykresy(
      zbior: ZbiorSerii,
      podmiot: string | null,
      zakres: Zakres,
      pary: ReadonlyArray<{ stack: Stack; usluga: Service }>,
    ): void {
      const sekcje = qa<HTMLElement>(app, '[data-role="wyk-sekcja"]');
      let ile = 0;
      for (const sekcja of sekcje) {
        const klucz = sekcja.dataset.podmiot ?? '';
        const figury = qa<HTMLElement>(sekcja, '[data-role="wyk-figura"]');
        if (klucz === 'vps') {
          const opisy = opisWykresowVps(zbior, zakres);
          figury.forEach((figura, indeks) => {
            const opis = opisy[indeks];
            if (!opis) return;
            rysujWykres(figura, opis, zakres, null);
            ile += 1;
          });
          const rdzenie = ostatniaWartosc(seriaVps(zbior, 'vps_rdzenie'));
          setText(
            sekcja,
            '[data-role="wyk-sekcja-podpis"]',
            rdzenie === null
              ? 'node-exporter'
              : `node-exporter · ${formatujLiczbe(rdzenie, 0)} rdzeni`,
          );
          continue;
        }
        const zbiorPar = podmiot === PODMIOT_WSZYSTKIE ? pary : wszystkiePary();
        const para = (zbiorPar.length > 0 ? zbiorPar : pary).find(
          (p) => kluczSerii(p.stack.name, p.usluga.name) === klucz,
        );
        if (!para) continue;
        const skrocony = podmiot === PODMIOT_WSZYSTKIE;
        const opisy = opisWykresowUslugi(para.usluga, para.stack.name, zbior, zakres, skrocony);
        figury.forEach((figura, indeks) => {
          const opis = opisy[indeks];
          if (!opis) return;
          rysujWykres(figura, opis, zakres, klucz);
          ile += 1;
        });
        setState(sekcja, '[data-role="wyk-dot"]', para.usluga.state);
        setText(
          sekcja,
          '[data-role="wyk-repliki"]',
          para.usluga.replicas_text ?? `${para.usluga.running ?? 0}/${para.usluga.desired ?? 0}`,
        );
      }
      setText(app, '[data-role="wykresy-licznik"]', `${ile} wykresów`);
    }

    /**
     * Przebudowa widoku wykresów. Wołane przy każdej zmianie trasy, ale DOM
     * rusza się tylko wtedy, gdy zmienił się podmiot, zakres albo zbiór usług —
     * inaczej odświeżanie co 5–10 s przewracałoby przewijanie.
     */
    async function renderWykresy(route: RouteWykresy): Promise<void> {
      const sekcje = q<HTMLElement>(app, '[data-role="wykresy-sekcje"]');
      if (!sekcje) return;

      if (!snapshot) {
        pokazKomunikatWykresow('Wczytywanie danych o usługach…');
        return;
      }

      const zakres = zakresZId(route.zakres);
      const widok = przygotujWidok(snapshot);
      const pary = widok.stacki.stacki.flatMap((stack) =>
        stack.services.map((usluga) => ({ stack, usluga })),
      );

      if (pary.length === 0 && route.podmiot !== null) {
        sygnaturaWykresow = '';
        sekcje.replaceChildren();
        pokazKomunikatWykresow('Filtr nie przepuszcza żadnej usługi — wyczyść filtr w widoku stanu.');
        return;
      }

      const zbior = await pobierzZbior(zakres);
      if (!zbior) {
        pokazKomunikatWykresow(
          'Nie udało się pobrać przebiegów z Prometheusa — wykresy są niedostępne, dane bieżące w widoku stanu nadal działają.',
        );
        return;
      }
      pokazKomunikatWykresow(null);

      const sygnatura = [
        route.podmiot ?? 'vps',
        zakres.id,
        route.podmiot === PODMIOT_WSZYSTKIE
          ? pary.map((para) => kluczSerii(para.stack.name, para.usluga.name)).join(',')
          : '',
      ].join('|');

      if (sygnatura !== sygnaturaWykresow) {
        sygnaturaWykresow = sygnatura;
        zbudujSekcjeWykresow(route.podmiot, pary, zakres);
      }
      wypelnijWykresy(zbior, route.podmiot, zakres, pary);
      zaktualizujPodpisOdswiezania();
      void renderTop(zakres);
    }

    /**
     * Wszystkie usługi ze snapshotu (bez filtra). Selektor podmiotu — jak ten
     * w widoku „Logi" — jest niezależny od filtra, więc wybrana usługa musi się
     * rozwiązać także wtedy, gdy filtr ukrywa jej kartę. Inaczej kliknięcie
     * w zapisany link kończyłoby się „nie znaleziono usługi".
     */
    function wszystkiePary(): Array<{ stack: Stack; usluga: Service }> {
      if (!snapshot) return [];
      return snapshot.stacks.flatMap((stack) =>
        stack.services.map((usluga) => ({ stack, usluga })),
      );
    }

    function zaktualizujPodpisOdswiezania(): void {
      const trasa = zHaszaWykresy(window.location.hash);
      const odswiezanie = odswiezanieZId(trasa.odswiez);
      setText(app, '[data-role="wykresy-odswiez-podpis"]', podpisOdswiezania(odswiezanie));
      setText(
        app,
        '[data-role="wykresy-aktualizacja"]',
        `aktualizacja ${new Date().toISOString().slice(11, 19)} UTC`,
      );
    }

    /** Odświeżenie danych w miejscu — wołane przez timer widoku wykresów. */
    async function odswiezDaneWykresow(): Promise<void> {
      if (!snapshot || app.dataset.view !== 'wykresy') return;
      const route = parseRoute();
      if (route.kind !== 'wykresy') return;
      const zakres = zakresZId(route.zakres);
      const zbior = await pobierzZbior(zakres, true);
      if (!zbior) {
        pokazKomunikatWykresow('Odświeżenie nie powiodło się — Prometheus nie odpowiedział.');
        return;
      }
      pokazKomunikatWykresow(null);
      const widok = przygotujWidok(snapshot);
      const pary = widok.stacki.stacki.flatMap((stack) =>
        stack.services.map((usluga) => ({ stack, usluga })),
      );
      wypelnijWykresy(zbior, route.podmiot, zakres, pary);
      zaktualizujPodpisOdswiezania();
    }

    function zatrzymajTimerWykresow(): void {
      if (timerWykresow !== null) {
        window.clearInterval(timerWykresow);
        timerWykresow = null;
      }
    }

    /**
     * Timer odświeżania. Karta w tle = zero zapytań (`document.hidden`), a po
     * powrocie dane dociąga zdarzenie `visibilitychange`.
     */
    function ustawTimerWykresow(id: OdswiezId): void {
      zatrzymajTimerWykresow();
      const odswiezanie = odswiezanieZId(id);
      if (!czyOdswiezac(odswiezanie) || app.dataset.view !== 'wykresy') return;
      timerWykresow = window.setInterval(() => {
        if (document.hidden || app.dataset.view !== 'wykresy') return;
        void odswiezDaneWykresow();
      }, odswiezanie.ms as number);
    }

    /** Select podmiotu: „Cały VPS", „Wszystkie usługi" i każda usługa (jak w logach). */
    function wypelnijPodmioty(trasa: RouteWykresy): void {
      const select = q<HTMLSelectElement>(app, '[data-role="wykresy-podmiot"]');
      if (!select) return;
      const opcje = [
        { klucz: '', etykieta: 'Cały VPS (node-exporter)' },
        { klucz: PODMIOT_WSZYSTKIE, etykieta: 'Wszystkie usługi (CPU i RAM)' },
        ...opcjeUslug().map((opcja) => ({ klucz: opcja.klucz, etykieta: opcja.etykieta })),
      ];
      const sygnatura = opcje.map((opcja) => opcja.klucz).join('|');
      if (select.dataset.pelny !== sygnatura) {
        select.dataset.pelny = sygnatura;
        select.replaceChildren(
          ...opcje.map((opcja) => {
            const element = document.createElement('option');
            element.value = opcja.klucz;
            element.textContent = opcja.etykieta;
            return element;
          }),
        );
      }
      select.value = trasa.podmiot ?? '';
    }

    function eksportCsv(): void {
      if (!snapshot) return;
      const widok = przygotujWidok(snapshot);
      const wiersze: WierszCsv[] = widok.stacki.stacki.flatMap((stack) =>
        stack.services.map((usluga) => ({
          stack: stack.name,
          usluga: usluga.name,
          stan: stateLabel(usluga.state),
          repliki:
            usluga.replicas_text ?? `${usluga.running ?? DASH}/${usluga.desired ?? DASH}`,
          cpu: usluga.cpu_percent === null ? '' : fmtPercent(usluga.cpu_percent),
          ram: fmtBytes(usluga.mem_bytes),
          restarty: fmtInt(usluga.restarts_1h),
          obraz: usluga.image ?? '',
        })),
      );
      const znacznik = new Date().toISOString().slice(0, 16).replace(/[:T]/g, '-');
      const plik = new Blob([uslugiDoCsv(wiersze)], { type: 'text/csv;charset=utf-8' });
      const url = URL.createObjectURL(plik);
      const link = document.createElement('a');
      link.href = url;
      link.download = `monitoring-uslugi-${znacznik}.csv`;
      document.body.append(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
    }

    async function kopiuj(tekst: string, przycisk: HTMLElement): Promise<void> {
      if (!tekst) return;
      const pierwotny = przycisk.textContent ?? '';
      try {
        await navigator.clipboard.writeText(tekst);
        przycisk.textContent = 'Skopiowano';
      } catch {
        przycisk.textContent = 'Nie udało się';
      }
      window.setTimeout(() => {
        przycisk.textContent = pierwotny;
      }, 1200);
    }

    function licznikiStanow(): Record<StanFiltra, number> {
      const uslugi = (snapshot?.stacks ?? []).flatMap((stack) => stack.services);
      return {
        wszystko: uslugi.length,
        problemy: uslugi.filter((u) => pasujeStan(u.state, 'problemy')).length,
        krytyczne: uslugi.filter((u) => pasujeStan(u.state, 'krytyczne')).length,
        zdrowe: uslugi.filter((u) => pasujeStan(u.state, 'zdrowe')).length,
      };
    }

    function renderZmiany(): void {
      const grid = section('changes');
      if (!grid) return;
      const lista: Zmiana[] = poprzedni && snapshot ? zmianyMiedzy(poprzedni, snapshot) : [];
      // Wartości pochodzą ze stanów API, więc rzutowanie jest bezpieczne —
      // `filtry.ts` nie zna słownika `State` (moduł jest samowystarczalny).
      updateSection('changes', lista.map((zmiana) => zmiana.stan as State), String(lista.length));

      const brak = q<HTMLElement>(grid, '[data-role="empty"]');
      if (brak) brak.hidden = poprzedni !== null;
      const czyste = q<HTMLElement>(grid, '[data-role="empty-clear"]');
      if (czyste) czyste.hidden = !(poprzedni !== null && lista.length === 0);

      if (!stale('changes', lista)) return;
      const holder = q<HTMLElement>(grid, '[data-role="list"]');
      if (!holder) return;
      holder.replaceChildren();

      for (const zmiana of lista) {
        const row = instantiate('tpl-zmiana');
        if (!row) continue;
        row.dataset.state = zmiana.stan;
        setTextWithTitle(row, '[data-role="tytul"]', zmiana.tytul);
        setTextWithTitle(row, '[data-role="opis"]', zmiana.opis);
        setText(row, '[data-role="czas"]', lastGoodAt ? fmtAgo(lastGoodAt) : '');
        const pokaz = q<HTMLButtonElement>(row, '[data-role="pokaz"]');
        if (pokaz) {
          if (zmiana.fokus) {
            pokaz.hidden = false;
            pokaz.dataset.fokus = zmiana.fokus;
          } else {
            pokaz.hidden = true;
            delete pokaz.dataset.fokus;
          }
        }
        holder.append(row);
      }
    }

    /**
     * Wskaźnik aktywnego sortowania: `aria-sort` na `<th>` (dla czytników
     * ekranu), `data-kierunek` na przycisku (dla CSS — strzałka w SVG tylko
     * w aktywnej kolumnie) i `title`, który mówi wprost, co się stanie po
     * kliknięciu. Kolumny nieaktywne nie mają ani strzałki, ani `aria-sort`.
     */
    function ustawAriaSort(): void {
      for (const naglowek of qa<HTMLElement>(app, '[data-section="stacks"] thead th')) {
        const przycisk = q<HTMLElement>(naglowek, '[data-sort]');
        const klucz = przycisk?.dataset.sort;
        const aktywny = klucz !== undefined && klucz === filtr.sort;
        const kierunek = aktywny ? filtr.kierunek : null;
        naglowek.setAttribute(
          'aria-sort',
          kierunek === null ? 'none' : kierunek === 'desc' ? 'descending' : 'ascending',
        );
        if (!przycisk) continue;
        przycisk.dataset.kierunek = kierunek ?? '';
        const nazwa = etykietaSortowania(klucz as KluczSortowania);
        przycisk.title =
          kierunek === null
            ? `Sortuj usługi w stacku po: ${nazwa}`
            : `${nazwa} — sortowanie ${kierunek === 'desc' ? 'malejąco' : 'rosnąco'} w obrębie stacka; kliknij, aby odwrócić`;
      }
    }

    /**
     * Korekta stanów pustych po sekcjach. Powód: sekcja wie tylko, ile dostała
     * wierszy — nie wie, czy reszta wypadła przez filtr, czy jej w API nie ma.
     */
    function ustawPusteStany(widok: Widok): void {
      const ustaw = (sekcja: string, pokazano: number, wszystkich: number): void => {
        const el = section(sekcja);
        if (!el) return;
        const brakDanych = q<HTMLElement>(el, '[data-role="empty"]');
        if (brakDanych) brakDanych.hidden = wszystkich > 0;
        const poFiltrze = q<HTMLElement>(el, '[data-role="empty-filtr"]');
        if (poFiltrze) poFiltrze.hidden = !(wszystkich > 0 && pokazano === 0);
      };

      ustaw('checks', widok.checki.pokazano, widok.checki.wszystkich);
      ustaw('certs', widok.certy.pokazano, widok.certy.wszystkich);
      ustaw('stacks', widok.stacki.pokazano, widok.stacki.wszystkich);
      ustaw('alerts', widok.alerty.pokazano, widok.alerty.wszystkich);

      // Alerty mają dodatkowy, „spokojny" stan — pokazujemy go tylko wtedy, gdy
      // naprawdę nie ma alertów (filtr, który je ukrył, to inna sytuacja).
      const czyste = q<HTMLElement>(app, '[data-section="alerts"] [data-role="empty-clear"]');
      if (czyste) czyste.hidden = widok.alerty.wszystkich > 0;

      const sec = section('security');
      if (!sec) return;
      const brakLogowan = q<HTMLElement>(sec, '[data-role="logins-empty"]');
      if (brakLogowan) brakLogowan.hidden = widok.logowania.wszystkich > 0;
      const logowaniaPoFiltrze = q<HTMLElement>(sec, '[data-role="logins-empty-filtr"]');
      if (logowaniaPoFiltrze) {
        logowaniaPoFiltrze.hidden = !(
          widok.logowania.wszystkich > 0 && widok.logowania.pokazano === 0
        );
      }
    }

    function ustawLicznikiSekcji(widok: Widok): void {
      const ustaw = (sekcja: string, pokazano: number, wszystkich: number): void => {
        const el = section(sekcja);
        if (!el) return;
        const licznik = q<HTMLElement>(el, '[data-role="count-filtr"]');
        if (!licznik) return;
        const filtruje = pokazano !== wszystkich;
        licznik.hidden = !filtruje;
        licznik.textContent = filtruje ? `z ${wszystkich}` : '';
      };

      ustaw('checks', widok.checki.pokazano, widok.checki.wszystkich);
      ustaw('certs', widok.certy.pokazano, widok.certy.wszystkich);
      ustaw('stacks', widok.stacki.pokazano, widok.stacki.wszystkich);
      ustaw('alerts', widok.alerty.pokazano, widok.alerty.wszystkich);
    }

    /** Wszystkie kontrolki filtra w jednym miejscu — stan jest jeden, źródło prawdy też. */
    function renderFiltry(widok: Widok): void {
      const pole = q<HTMLInputElement>(app, '[data-role="filter-input"]');
      // Nie nadpisujemy tego, co użytkownik właśnie pisze.
      if (pole && document.activeElement !== pole && pole.value !== filtr.q) pole.value = filtr.q;

      const czysc = q<HTMLElement>(app, '[data-role="filter-clear"]');
      if (czysc) czysc.hidden = !czyAktywny(filtr);

      const liczniki = licznikiStanow();
      for (const stan of STANY_FILTRA) {
        const chip = q<HTMLElement>(app, `[data-action="filter-stan"][data-stan="${stan}"]`);
        if (!chip) continue;
        chip.setAttribute('aria-pressed', filtr.stan === stan ? 'true' : 'false');
        setText(chip, '.chip-licznik', String(liczniki[stan]));
      }

      const wybor = q<HTMLSelectElement>(app, '[data-role="filter-sort"]');
      if (wybor && wybor.value !== filtr.sort) wybor.value = filtr.sort;
      setText(app, '[data-role="filter-dir"]', filtr.kierunek === 'desc' ? '↓' : '↑');

      const podsumowanie = q<HTMLElement>(app, '[data-role="filter-count"]');
      if (podsumowanie) {
        podsumowanie.textContent = `${widok.stacki.pokazano} z ${widok.stacki.wszystkich} usług`;
      }

      const chipPaska = q<HTMLElement>(app, '[data-role="bar-filtr"]');
      if (chipPaska) {
        const opis = opisFiltra(filtr);
        chipPaska.hidden = opis.length === 0;
        setText(chipPaska, '[data-role="bar-filtr-tekst"]', opis);
      }

      ustawPusteStany(widok);
      ustawLicznikiSekcji(widok);
      ustawAriaSort();
    }

    /* ---------------- ranking „Top 10 usług" ---------------- */

    /** Wybrana metryka rankingu (stan w pamięci — nie zaśmieca hasza widoku). */
    let metrykaTop: MetrykaTop = 'cpu';
    /** Cache rankingu per metryka — 60 s, jak cache przebiegów. */
    const topCache = new Map<MetrykaTop, { kiedy: number; pozycje: PozycjaTop[] }>();

    async function pobierzTop(metryka: MetrykaTop): Promise<PozycjaTop[] | null> {
      const zapisane = topCache.get(metryka);
      if (zapisane && Date.now() - zapisane.kiedy < 60_000) return zapisane.pozycje;
      const teraz = Math.floor(Date.now() / 1000);
      try {
        const odpowiedz = await fetchWithTimeout(
          zbudujUrlQueryInstant(zapytanieTop(metryka).expr, teraz),
        );
        if (!odpowiedz.ok) throw new Error(`HTTP ${odpowiedz.status}`);
        const pozycje = parsujTop(await odpowiedz.json());
        topCache.set(metryka, { kiedy: Date.now(), pozycje });
        return pozycje;
      } catch {
        // Brak Prometheusa nie może psuć widoku — pokazujemy to wprost.
        return null;
      }
    }

    /** Rysuje ranking w istniejącym DOM (bez przebudowy przy odświeżeniu danych). */
    function rysujTop(kontener: HTMLElement, wszystkie: readonly PozycjaTop[]): void {
      const pozycje = ograniczTop(wszystkie);
      const maks = pozycje[0]?.wartosc ?? 0;
      const wiersze: HTMLElement[] = [];
      for (const pozycja of pozycje) {
        const wiersz = instantiate('tpl-wykres-top');
        if (!wiersz) continue;
        const nazwa = q<HTMLAnchorElement>(wiersz, '[data-role="top-nazwa"]');
        if (nazwa) {
          nazwa.textContent = `${pozycja.stack} / ${pozycja.usluga}`;
          nazwa.href = doHaszaWykresow(pozycja.klucz, zakresZId(zHaszaWykresy(window.location.hash).zakres).id);
          nazwa.title = `Szczegóły: ${pozycja.klucz}`;
        }
        const slupek = q<HTMLElement>(wiersz, '[data-role="top-slup"]');
        // Udział 0–1 w zmiennej CSS: animujemy `transform`, nie szerokość.
        if (slupek) {
          slupek.style.setProperty('--wypelnienie', String(szerokoscSlupka(pozycja.wartosc, maks) / 100));
        }
        setText(wiersz, '[data-role="top-wartosc"]', formatujWartoscTop(metrykaTop, pozycja.wartosc));
        wiersze.push(wiersz);
      }
      kontener.replaceChildren(...wiersze);
    }

    async function renderTop(zakres: Zakres): Promise<void> {
      const kontener = q<HTMLElement>(app, '[data-role="wykresy-top-lista"]');
      const pusta = q<HTMLElement>(app, '[data-role="wykresy-top-pusta"]');
      if (!kontener) return;
      for (const przycisk of qa<HTMLElement>(app, '[data-action="wykres-top"]')) {
        przycisk.setAttribute(
          'aria-pressed',
          przycisk.dataset.metryka === metrykaTop ? 'true' : 'false',
        );
      }
      setText(
        app,
        '[data-role="wykresy-top-podpis"]',
        `${zapytanieTop(metrykaTop).etykieta} · ${podpisZakresu(zakres)} · topk(10)`,
      );
      const pozycje = await pobierzTop(metrykaTop);
      if (pusta) pusta.hidden = pozycje !== null && pozycje.length > 0;
      if (pozycje === null) {
        kontener.replaceChildren();
        return;
      }
      rysujTop(kontener, pozycje);
    }

    /* ---------------- widok logów (własny, bez ramki Grafany) ---------------- */

    /** Ostatnio pobrane linie i to, co z nich widać po filtrze. */
    let ostatnieLogi: LiniaLogu[] = [];
    let widoczneLogi: LiniaLogu[] = [];
    /** Sygnatura listy — bez zmiany nie rusza się DOM (inaczej scroll skakałby co 30 s). */
    let sygnaturaLogow = '';
    let debounceLogow: number | null = null;
    /** Zapytanie LogQL zwrócone przez serwer (dla deep-linku do Grafany). */
    let ostatnieZapytanieLogow = '';

    /** Lista usług do wyboru — pełna, nieprzefiltrowana (logi to nie widok stanu). */
    function opcjeUslug(): Array<{ klucz: string; etykieta: string }> {
      if (!snapshot) return [];
      return snapshot.stacks
        .flatMap((stack) => stack.services.map((usluga) => ({
          klucz: kluczSerii(stack.name, usluga.name),
          etykieta: `${stack.name} / ${usluga.name}`,
        })))
        .sort((a, b) => a.etykieta.localeCompare(b.etykieta, 'pl'));
    }

    function wypelnijUslugi(trasa: RouteLogi): void {
      const select = q<HTMLSelectElement>(app, '[data-role="logi-usluga"]');
      if (!select) return;
      const opcje = opcjeUslug();
      const obecne = opcje.map((opcja) => opcja.klucz).join('|');
      if (select.dataset.pelny !== obecne) {
        select.dataset.pelny = obecne;
        select.replaceChildren(
          ...opcje.map((opcja) => {
            const element = document.createElement('option');
            element.value = opcja.klucz;
            element.textContent = opcja.etykieta;
            return element;
          }),
        );
      }
      select.value = trasa.usluga ?? '';
    }

    function ustawPolaLogow(trasa: RouteLogi): void {
      const zrodlo = q<HTMLSelectElement>(app, '[data-role="logi-zrodlo"]');
      if (zrodlo) zrodlo.value = trasa.zrodlo;
      // Wybór usługi ma sens tylko dla źródła „usługa" — przy hoście i Traefiku
      // chowamy go, żeby nie sugerować, że da się filtrować po usłudze.
      const poleUslugi = q<HTMLElement>(app, '.logi-pole-usluga');
      if (poleUslugi) poleUslugi.hidden = trasa.zrodlo !== 'usluga';
      wypelnijUslugi(trasa);
    }

    function pokazKomunikatLogow(tekst: string | null): void {
      const komunikat = q<HTMLElement>(app, '[data-role="logi-komunikat"]');
      if (!komunikat) return;
      komunikat.hidden = tekst === null;
      komunikat.textContent = tekst ?? '';
    }

    function rysujLinieLogow(): void {
      const lista = q<HTMLElement>(app, '[data-role="logi-lista"]');
      const pustka = q<HTMLElement>(app, '[data-role="logi-pustka"]');
      if (!lista) return;
      const zakres = zakresLogowZId(zHaszaLogi(window.location.hash).zakres);

      const wiersze: HTMLElement[] = [];
      for (const linia of widoczneLogi) {
        const wiersz = instantiate('tpl-log-linia');
        if (!wiersz) continue;
        setText(wiersz, '[data-role="log-czas"]', formatujCzasLogu(linia.czas, zakres));
        setText(wiersz, '[data-role="log-strumien"]', linia.strumien);
        setText(wiersz, '[data-role="log-tresc"]', linia.tekst);
        wiersz.title = linia.tekst;
        wiersze.push(wiersz);
      }
      lista.replaceChildren(...wiersze);
      if (pustka) pustka.hidden = widoczneLogi.length > 0;
    }

    async function renderLogi(route: RouteLogi, zakres: ZakresLogow): Promise<void> {
      const lista = q<HTMLElement>(app, '[data-role="logi-lista"]');
      if (!lista) return;
      ustawPolaLogow(route);

      if (route.zrodlo === 'usluga' && !route.usluga) {
        ostatnieLogi = [];
        widoczneLogi = [];
        sygnaturaLogow = '';
        lista.replaceChildren();
        pokazKomunikatLogow('Wybierz usługę z listy powyżej (albo wejdź tu z widoku stanu, klikając „Logi" przy usłudze).');
        const pustkaWybór = q<HTMLElement>(app, '[data-role="logi-pustka"]');
        if (pustkaWybór) pustkaWybór.hidden = true;
        return;
      }

      const limit = limitLiniiZId(q<HTMLSelectElement>(app, '[data-role="logi-limit"]')?.value);
      // `rozbijFokus` zwraca obiekt (albo null), a nie krotkę — usługa z trasy
      // może być zapisana jako `stack/usługa` albo samą nazwą.
      const czesciUslugi = rozbijFokus(route.usluga);
      const stack = czesciUslugi?.stack ?? '';
      const usluga = czesciUslugi?.usluga ?? '';
      const adres = zbudujUrlLogow(stack, usluga, route.zrodlo, zakres, limit);

      let dane: unknown = null;
      try {
        const odpowiedz = await fetchWithTimeout(adres);
        dane = await odpowiedz.json();
        if (!odpowiedz.ok) {
          pokazKomunikatLogow(bladLogow(dane) ?? `Nie udało się pobrać logów (HTTP ${odpowiedz.status}).`);
          return;
        }
      } catch {
        // Brak Loki nie może psuć panelu — mówimy wprost, że nie wiemy.
        pokazKomunikatLogow('Nie udało się pobrać logów — usługa zbierająca nie odpowiedziała.');
        return;
      }

      const blad = bladLogow(dane);
      if (blad) {
        pokazKomunikatLogow(blad);
        return;
      }
      pokazKomunikatLogow(null);

      const fraza = q<HTMLInputElement>(app, '[data-role="logi-filtr"]')?.value ?? '';
      ostatnieLogi = parsujOdpowiedzLoki(dane);
      widoczneLogi = filtrujLinie(ostatnieLogi, fraza);
      ostatnieZapytanieLogow =
        (typeof (dane as { zapytanie?: unknown })?.zapytanie === 'string'
          ? ((dane as { zapytanie: string }).zapytanie)
          : '') || zapytanieZrodla(route.zrodlo, stack, usluga);

      const sygnatura = [
        route.zrodlo,
        route.usluga ?? '',
        zakres.id,
        String(limit),
        fraza,
        String(widoczneLogi.length),
        String(widoczneLogi[0]?.czas ?? 0),
      ].join('|');
      if (sygnatura !== sygnaturaLogow) {
        sygnaturaLogow = sygnatura;
        rysujLinieLogow();
      }

      setText(app, '[data-role="logi-licznik"]', podsumowanieLogow(widoczneLogi.length, ostatnieLogi.length, limit));
      setText(app, '[data-role="logi-zapytanie"]', ostatnieZapytanieLogow);

      const grafana = q<HTMLAnchorElement>(app, '[data-role="logi-grafana"]');
      if (grafana) grafana.href = linkGrafanaExplore(ostatnieZapytanieLogow, zakres);

      const pustka = q<HTMLElement>(app, '[data-role="logi-pustka"]');
      if (pustka) {
        pustka.hidden = widoczneLogi.length > 0;
        setText(
          pustka,
          '[data-role="logi-pustka-tekst"]',
          ostatnieLogi.length > 0
            ? 'Żadna linia nie pasuje do filtra — wyczyść filtr.'
            : podpowiedzPustki(route.zrodlo, zakres),
        );
      }
    }

    /** Zapis widocznych linii do pliku (to samo, co idzie do schowka). */
    function pobierzLogi(): void {
      if (widoczneLogi.length === 0) return;
      const zakres = zakresLogowZId(zHaszaLogi(window.location.hash).zakres);
      const znacznik = new Date().toISOString().slice(0, 16).replace(/[:T]/g, '-');
      const plik = new Blob([eksportLogow(widoczneLogi, zakres)], {
        type: 'text/plain;charset=utf-8',
      });
      const url = URL.createObjectURL(plik);
      const link = document.createElement('a');
      link.href = url;
      link.download = `monitoring-logi-${znacznik}.log`;
      document.body.append(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
    }

    /* ---------------- zdarzenia ---------------- */


    window.addEventListener('hashchange', () => {
      wczytajStanZHasza();
      odswiezWidok();
    });

    /*
     * Zmiana preferencji systemu w trakcie pracy (np. automatyczny tryb nocny):
     * sam panel przełącza się arkuszem stylów, ale ramka narzędzia ma własny
     * motyw — więc podmieniamy jej adres tylko wtedy, gdy narzędzie rozumie
     * `theme=` (Grafana, Prometheus). Bez tego jasny panel trzymałby ciemną
     * ramkę w środku.
     */
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      if (!frame || !mountedToolId) return;
      const narzedzie = snapshot?.tools.find((t) => t.id === mountedToolId);
      if (!narzedzie?.url) return;
      const nowy = adresPoZmianieMotywu(
        narzedzie.id,
        narzedzie.url,
        narzedzie.embed_query,
        ciemnySystemu(),
      );
      if (!nowy || nowy === frame.src) return;
      frame.src = nowy;
    });
    document.addEventListener('fullscreenchange', renderFullscreenState);

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const trigger = target.closest('[data-action]');
      if (trigger instanceof HTMLElement) {
        const action = trigger.dataset.action;
        if (action === 'refresh' || action === 'retry') void load();
        if (action === 'fullscreen') void toggleFullscreen();
        if (action === 'filter-stan') {
          ustawStanFiltra((trigger.dataset.stan ?? 'wszystko') as StanFiltra);
        }
        if (action === 'filter-kierunek') {
          filtr = { ...filtr, kierunek: filtr.kierunek === 'desc' ? 'asc' : 'desc' };
          odswiezWidok();
        }
        if (action === 'filter-clear') wyczyscFiltr();
        if (action === 'filter-csv') eksportCsv();
        if (action === 'sortuj') ustawSortowanie(trigger.dataset.sort ?? 'stan');
        if (action === 'stack-zwijanie') przelaczZwiniety(trigger.closest('[data-role="stack"]'));
        if (action === 'stack-filtr') ustawFiltrStacka(trigger.dataset.stack ?? '');
        if (action === 'usluga-fokus') {
          przelaczFokus(trigger.dataset.stack ?? '', trigger.dataset.usluga ?? '');
        }
        if (action === 'wykres-zakres') {
          const zakres = zakresZId(trigger.dataset.zakres);
          const trasa = zHaszaWykresy(window.location.hash);
          window.location.hash = doHaszaWykresow(trasa.podmiot, zakres.id, trasa.odswiez);
          return;
        }
        if (action === 'wykres-top') {
          metrykaTop = metrykaTopZId(trigger.dataset.metryka);
          void renderTop(zakresZId(zHaszaWykresy(window.location.hash).zakres));
          return;
        }
        if (action === 'log-zakres') {
          const zakres = zakresLogowZId(trigger.dataset.zakres);
          const trasa = zHaszaLogi(window.location.hash);
          window.location.hash = doHaszaLogi(trasa.usluga, zakres.id, trasa.zrodlo);
          return;
        }
        if (action === 'log-kopiuj') {
          const zakres = zakresLogowZId(zHaszaLogi(window.location.hash).zakres);
          void kopiuj(eksportLogow(widoczneLogi, zakres), trigger);
          return;
        }
        if (action === 'log-pobierz') {
          pobierzLogi();
          return;
        }
        if (action === 'wykres-usluga') {
          const trasa = zHaszaWykresy(window.location.hash);
          window.location.hash = doHaszaWykresow(
            trigger.dataset.usluga ?? null,
            zakresZId(trasa.zakres).id,
            trasa.odswiez,
          );
          return;
        }
        if (action === 'pokaz-fokus') {
          const czesci = rozbijFokus(trigger.dataset.fokus ?? null);
          if (czesci) przelaczFokus(czesci.stack, czesci.usluga);
        }
        if (action === 'kopiuj') void kopiuj(trigger.dataset.kopiuj ?? '', trigger);
        return;
      }

      // Klik w wiersz usługi poza przyciskami i linkami też rozwija szczegóły —
      // trafienie w tabelę nie może wymagać celowania w samą nazwę.
      const wiersz = target.closest('tr[data-role="service"]');
      if (wiersz instanceof HTMLElement && !target.closest('a,button')) {
        const nazwa = q<HTMLElement>(wiersz, '[data-role="name"]');
        przelaczFokus(nazwa?.dataset.stack ?? '', nazwa?.dataset.usluga ?? '');
      }
    });

    document.addEventListener('input', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement)) return;
      // Filtr logów działa na już pobranych liniach (podciąg), więc nie pyta
      // serwera ponownie — wystarczy przerysować listę.
      if (target.dataset.role === 'logi-filtr') {
        const fraza = target.value;
        if (debounceLogow !== null) window.clearTimeout(debounceLogow);
        debounceLogow = window.setTimeout(() => {
          debounceLogow = null;
          const trasa = zHaszaLogi(window.location.hash);
          const zakres = zakresLogowZId(trasa.zakres);
          widoczneLogi = filtrujLinie(ostatnieLogi, fraza);
          sygnaturaLogow = '';
          rysujLinieLogow();
          setText(
            app,
            '[data-role="logi-licznik"]',
            podsumowanieLogow(widoczneLogi.length, ostatnieLogi.length, limitLiniiZId(
              q<HTMLSelectElement>(app, '[data-role="logi-limit"]')?.value,
            )),
          );
          const pustka = q<HTMLElement>(app, '[data-role="logi-pustka"]');
          if (pustka) {
            pustka.hidden = widoczneLogi.length > 0;
            setText(
              pustka,
              '[data-role="logi-pustka-tekst"]',
              ostatnieLogi.length > 0
                ? 'Żadna linia nie pasuje do filtra — wyczyść filtr.'
                : podpowiedzPustki(trasa.zrodlo, zakres),
            );
          }
        }, 120);
        return;
      }
      if (target.dataset.role !== 'filter-input') return;
      const wartosc = target.value;
      // Debounce: przy 47 usługach przemalowanie sekcji na każde naciśnięcie
      // klawisza to zauważalne miganie.
      if (debounceFiltra !== null) window.clearTimeout(debounceFiltra);
      debounceFiltra = window.setTimeout(() => {
        debounceFiltra = null;
        filtr = { ...filtr, q: wartosc };
        odswiezWidok();
      }, 120);
    });

    document.addEventListener('change', (event) => {
      const target = event.target;
      if (target instanceof HTMLSelectElement && target.dataset.role === 'filter-sort') {
        // Wybór z listy to świadoma zmiana klucza — ustawiamy sensowny kierunek,
        // a nie odwracamy obecny (to robi klik w nagłówek kolumny).
        const klucz = target.value;
        filtr = {
          ...filtr,
          sort: (KLUCZE_SORTOWANIA as readonly string[]).includes(klucz)
            ? (klucz as KluczSortowania)
            : filtr.sort,
          kierunek: klucz === 'usluga' || klucz === 'obraz' ? 'asc' : 'desc',
        };
        odswiezWidok();
      }
      if (target instanceof HTMLSelectElement && target.dataset.role === 'wykresy-podmiot') {
        const trasa = zHaszaWykresy(window.location.hash);
        window.location.hash = doHaszaWykresow(
          target.value || null,
          zakresZId(trasa.zakres).id,
          trasa.odswiez,
        );
        return;
      }
      if (target instanceof HTMLSelectElement && target.dataset.role === 'wykresy-odswiez') {
        const trasa = zHaszaWykresy(window.location.hash);
        const odswiezanie = odswiezanieZId(target.value);
        window.location.hash = doHaszaWykresow(trasa.podmiot, zakresZId(trasa.zakres).id, odswiezanie.id);
        return;
      }
      if (target instanceof HTMLSelectElement && target.dataset.role === 'logi-zrodlo') {
        const trasa = zHaszaLogi(window.location.hash);
        // Zmiana źródła kasuje wybór usługi tylko wtedy, gdy nowe źródło jej
        // nie używa — inaczej powrót do „Usługa" gubiłby kontekst.
        window.location.hash = doHaszaLogi(trasa.usluga, trasa.zakres, zrodloLogowZId(target.value).id);
        return;
      }
      if (target instanceof HTMLSelectElement && target.dataset.role === 'logi-usluga') {
        const trasa = zHaszaLogi(window.location.hash);
        window.location.hash = doHaszaLogi(target.value || null, trasa.zakres, trasa.zrodlo);
        return;
      }
      if (target instanceof HTMLSelectElement && target.dataset.role === 'logi-limit') {
        // Limit zmienia zapytanie (ile linii pobrać), więc pobieramy od nowa.
        const trasa = zHaszaLogi(window.location.hash);
        void renderLogi(
          { kind: 'logi', usluga: trasa.usluga, zakres: trasa.zakres, zrodlo: trasa.zrodlo },
          zakresLogowZId(trasa.zakres),
        );
      }
    });

    document.addEventListener('keydown', (event) => {
      const aktywne = document.activeElement;
      const wPolu =
        aktywne instanceof HTMLInputElement ||
        aktywne instanceof HTMLTextAreaElement ||
        aktywne instanceof HTMLSelectElement;
      if (event.key === '/' && !wPolu) {
        event.preventDefault();
        // „/” trafia w pole TEGO widoku, który jest na ekranie — w widoku logów
        // filtrowanie jest pierwszą rzeczą, po którą sięgamy.
        const pole = app.dataset.view === 'logi'
          ? q<HTMLInputElement>(app, '[data-role="logi-filtr"]')
          : q<HTMLInputElement>(app, '[data-role="filter-input"]');
        pole?.focus();
        return;
      }
      if (event.key === 'Escape') {
        if (wPolu && aktywne instanceof HTMLElement) aktywne.blur();
        if (app.dataset.view === 'logi') {
          const pole = q<HTMLInputElement>(app, '[data-role="logi-filtr"]');
          if (pole && pole.value !== '') {
            pole.value = '';
            widoczneLogi = filtrujLinie(ostatnieLogi, '');
            sygnaturaLogow = '';
            rysujLinieLogow();
            return;
          }
        }
        wyczyscFiltr();
      }
    });

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState !== 'visible') return;
      const isStale = !lastGoodAt || Date.now() - lastGoodAt.getTime() > refreshMs;
      if (isStale) void load();
      // Wykresy mają własny cykl: w tle nie pytamy Prometheusa, więc po powrocie
      // na kartę dane mogły się zestarzeć o cały czas nieobecności.
      if (app.dataset.view === 'wykresy') void odswiezDaneWykresow();
    });

    window.setInterval(() => void load(), refreshMs);
    // Tani ticker: odświeża „x temu” i wykrywa ciszę w odświeżaniu.
    window.setInterval(() => {
      renderMeta();
      renderBanner();
    }, 5_000);

    /* ---------------- start ---------------- */

    wczytajZwiete();
    wczytajStanZHasza();
    renderMeta();
    const sekcjeWykresow = q<HTMLElement>(app, '[data-role="wykresy-sekcje"]');
    if (sekcjeWykresow) podlaczTooltipy(sekcjeWykresow);
    applyRoute();
    void load();
  }

  const root = document.getElementById('app');
  if (root instanceof HTMLElement) bootstrap(root);
</script>
