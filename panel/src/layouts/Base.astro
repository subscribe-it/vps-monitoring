---
/**
 * Powłoka HTML panelu. Wszystkie zasoby są lokalne (styl + favicon + sprite),
 * więc strona nie wykonuje żadnych zapytań do internetu.
 */
import '../styles/global.css';
import IconSprite from '../components/IconSprite.astro';
import { SKRYPT_MOTYWU } from '../lib/motyw';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Panel monitoringu infrastruktury VPS — stan usług, certyfikatów i kopii zapasowych.',
} = Astro.props;
---

<!doctype html>
<!-- Bez `data-theme` w statycznym znaczniku: domyślnie motyw wybiera system
     (`prefers-color-scheme`), a atrybut ustawiony na sztywno nadpisałby tę
     preferencję. Jawny wybór użytkownika (jasny/ciemny, zapisany w
     `localStorage`) dokłada go skryptem niżej — jeszcze przed pierwszym
     malowaniem, więc nie ma mignięcia złego motywu. Skrypt pochodzi z
     `lib/motyw.ts`, żeby klucz i nazwy motywów miały jedno źródło prawdy. -->
<html lang="pl">
  <head>
    <script is:inline set:html={SKRYPT_MOTYWU}></script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <IconSprite />
  </head>
  <body>
    <a class="skip-link" href="#main">Przejdź do treści</a>
    <slot />
  </body>
</html>
