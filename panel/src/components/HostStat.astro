---
/**
 * Pojedynczy kafelek mini-statystyki hosta (CPU, RAM, dysk, uptime...).
 * Wartość wpisuje skrypt klienta w `[data-role="value"]`, pasek w
 * `[data-role="meter"]`, opis w `[data-role="sub"]`.
 *
 * Kafelek jest zwarty: etykieta 12 px, wartość 16 px, opis maksymalnie dwie
 * linie (pełna treść trafia do atrybutu `title` w skrypcie). Dzięki temu osiem
 * statystyk mieści się w jednym rzędzie i nie zjada pionu ekranu.
 */
import { Icon } from 'astro-icon/components';

interface Props {
  /** Klucz statystyki, np. `cpu` — skrypt szuka `[data-stat="cpu"]`. */
  stat: string;
  label: string;
  icon: string;
  /** Czy pokazywać pasek zużycia (dla wartości procentowych). */
  meter?: boolean;
}

const { stat, label, icon, meter = false } = Astro.props;
---

<div class="stat-tile" data-stat={stat} data-state="unknown">
  <div class="flex items-center gap-1.5">
    <Icon name={icon} size={13} class="state-text" aria-hidden="true" />
    <span class="card-title text-xs">{label}</span>
  </div>
  <div class="num text-base leading-tight font-semibold" data-role="value">—</div>
  {
    meter && (
      <div
        class="meter"
        role="progressbar"
        aria-label={label}
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        aria-valuetext="brak danych"
        data-role="meter"
      >
        <span style="transform:scaleX(0)"></span>
      </div>
    )
  }
  <div class="subtle line-clamp-2 text-xs leading-snug" data-role="sub">—</div>
</div>
