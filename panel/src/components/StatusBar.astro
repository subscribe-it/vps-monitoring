---
/**
 * Przyklejony pasek stanu — jedyna rzecz w panelu, która jest widoczna
 * nieprzerwanie.
 *
 * Powód istnienia: strona ze stanem ma kilka tysięcy pikseli (47 usług,
 * 16 endpointów). Przewijając „Stacki” użytkownik tracił z oczu odpowiedź na
 * dwa pytania: „czy coś jest zepsute?” i „czy dane są świeże?”. Pasek niesie
 * dokładnie te dwie informacje plus akcje: odświeżenie, wejście w Wykresy
 * i Logi oraz przełącznik motywu.
 *
 * Wartości wypełnia skrypt klienta (role `sticky-*`), a `data-action="refresh"`
 * obsługuje ten sam delegowany handler co przycisk w nagłówku.
 *
 * Przełącznik motywu jest `radiogroup`, a nie trzema `aria-pressed`: to jeden
 * wybór z trzech (auto / jasny / ciemny), więc czytnik ekranu ma zapowiedzieć
 * „1 z 3”, a nie trzy niezależne przełączniki. Strzałki przeskakują między
 * opcjami (roving tabindex), a wybór zapisuje się w `localStorage` i działa
 * jeszcze przed pierwszym malowaniem (skrypt w `Base.astro`).
 */
import { Icon } from 'astro-icon/components';
import { opisWyboru, skrotWyboru } from '../lib/motyw';
---

<div class="sticky-bar" data-section="sticky" data-state="unknown">
  <span class="state-dot" aria-hidden="true"></span>
  <span class="text-sm font-semibold" data-role="sticky-label">—</span>
  <span class="muted text-xs" data-role="sticky-note"></span>
  <span class="bar-filtr" data-role="bar-filtr" hidden>
    <Icon name="lucide:filter" size={12} aria-hidden="true" />
    <span class="bar-filtr-tekst" data-role="bar-filtr-tekst"></span>
    <button
      type="button"
      class="bar-filtr-x"
      data-action="filter-clear"
      data-role="bar-filtr-x"
      aria-label="Wyczyść filtr"
    >
      <Icon name="lucide:x" size={12} aria-hidden="true" />
    </button>
  </span>
  <span class="ml-auto flex flex-wrap items-center justify-end gap-2 sm:gap-3">
    <span
      class="subtle hidden items-center gap-1.5 text-xs sm:flex"
      data-role="sticky-fresh"
      data-state="unknown"
    >
      <span class="state-dot" aria-hidden="true"></span>
      <span class="num" data-role="sticky-updated">—</span>
      <span data-role="sticky-ago"></span>
    </span>
    <span class="motyw" role="radiogroup" aria-label="Motyw panelu" data-role="motyw">
      <button
        type="button"
        class="motyw-opcja"
        role="radio"
        aria-checked="true"
        tabindex="0"
        data-action="motyw"
        data-wybor="auto"
        data-role="motyw-auto"
        title={opisWyboru('auto')}
      >
        <Icon name="lucide:monitor" size={14} aria-hidden="true" />
        <span class="motyw-etykieta">{skrotWyboru('auto')}</span>
        <span class="sr-only">— {opisWyboru('auto')}</span>
      </button>
      <button
        type="button"
        class="motyw-opcja"
        role="radio"
        aria-checked="false"
        tabindex="-1"
        data-action="motyw"
        data-wybor="jasny"
        data-role="motyw-jasny"
        title={opisWyboru('jasny')}
      >
        <Icon name="lucide:sun" size={14} aria-hidden="true" />
        <span class="motyw-etykieta">{skrotWyboru('jasny')}</span>
        <span class="sr-only">— {opisWyboru('jasny')}</span>
      </button>
      <button
        type="button"
        class="motyw-opcja"
        role="radio"
        aria-checked="false"
        tabindex="-1"
        data-action="motyw"
        data-wybor="ciemny"
        data-role="motyw-ciemny"
        title={opisWyboru('ciemny')}
      >
        <Icon name="lucide:moon" size={14} aria-hidden="true" />
        <span class="motyw-etykieta">{skrotWyboru('ciemny')}</span>
        <span class="sr-only">— {opisWyboru('ciemny')}</span>
      </button>
    </span>
    <a
      class="btn-ops"
      data-role="nav-logi"
      href="#/logi"
      title="Logi usług, hosta i edge’a — bez wchodzenia do Grafany"
    >
      <Icon name="lucide:scroll-text" size={14} aria-hidden="true" />
      <span>Logi</span>
    </a>
    <a
      class="btn-ops"
      data-role="nav-wykresy"
      href="#/wykresy"
      title="Wykresy per usługa — bez wchodzenia do Grafany"
    >
      <Icon name="lucide:chart-line" size={14} aria-hidden="true" />
      <span>Wykresy</span>
    </a>
    <button type="button" class="btn-ops" data-action="refresh">
      <Icon name="lucide:refresh-cw" size={14} aria-hidden="true" />
      <span>Odśwież</span>
    </button>
  </span>
</div>
