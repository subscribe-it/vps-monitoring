---
/**
 * Sekcja (d): kopia zapasowa (`backup`). Wartości procentowe i czasowe
 * formatowane po stronie klienta; stan pochodzi wprost z API.
 *
 * Sześć pól układa się w jednym rzędzie wypełniającym kartę (`.field-grid`
 * z auto-fit), dzięki czemu sekcja jest niska niezależnie od szerokości okna.
 */
import { Icon } from 'astro-icon/components';
import SectionCard from './SectionCard.astro';
import StatBlock from './StatBlock.astro';
---

<SectionCard section="backup" title="Kopia zapasowa" icon="lucide:database-backup">
  <div class="field-grid">
    <StatBlock field="backup-state" label="Stan" icon="lucide:shield-check" />
    <StatBlock field="backup-last" label="Ostatnia kopia" icon="lucide:calendar-clock" />
    <StatBlock field="backup-age" label="Wiek kopii" icon="lucide:timer" />
    <StatBlock field="backup-size" label="Rozmiar" icon="lucide:archive" />
    <StatBlock field="backup-objects" label="Obiekty w R2" icon="lucide:layers" />
    <StatBlock field="backup-restore" label="Test odtworzenia" icon="lucide:circle-check" />
  </div>
  <div class="empty-ops" data-role="empty" hidden>
    <Icon name="lucide:inbox" size={16} aria-hidden="true" />
    <span>Brak danych o kopii zapasowej — API nie zwróciło tej sekcji.</span>
  </div>
</SectionCard>
