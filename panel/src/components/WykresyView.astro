---
/**
 * Widok „Wykresy" — własne wykresy panelu (bez ramki Grafany).
 *
 * Po co: żeby zobaczyć zużycie nie trzeba wchodzić do Grafany; osadzona ramka
 * oddaje wykresy razem z jej nawigacją i nie da się w niej przeskoczyć
 * „ta usługa, ale w 24 h".
 *
 * Układ (wymagania użytkownika):
 *   - domyślnie wykresy CAŁEGO VPS-a, a nad nimi selektor podmiotu (wzorzec
 *     z widoku „Logi"): „Cały VPS", „Wszystkie usługi", poszczególne usługi,
 *   - maksymalnie DWIE karty wykresów w wierszu, karta do 800 px szerokości,
 *   - nad każdym wykresem tytuł mówiący, czego dotyczy („CPU — cały VPS"),
 *   - sekcje usług mają wyraźny nagłówek i separator, żeby nie było wątpliwości,
 *     gdzie kończy się jedna usługa.
 *
 * Wykresy rysujemy jako `<polyline>` w SVG (jak sparkline w tabeli usług) —
 * żadnych zewnętrznych bibliotek. Tooltip to zwykłe elementy DOM nad rysunkiem,
 * więc działa też z klawiatury (strzałki na wykresie).
 *
 * Role mają prefiks `wyk-`, żeby nie kolidowały z innymi widokami (`d-*`, `log-*`).
 */
import { Icon } from 'astro-icon/components';
import { ODSWIEZANIA } from '../lib/wykresy';
---

<section class="wykresy-view" data-role="wykresy-view" aria-label="Wykresy" hidden>
  <div class="card-ops wykresy-naglowek">
    <a class="btn-ops" data-role="wykresy-powrot" href="#/">
      <Icon name="lucide:arrow-left" size={14} aria-hidden="true" />
      <span>Wróć do stanu</span>
    </a>
    <div class="wykresy-tytul">
      <h2 class="card-title" data-role="wykresy-naglowek">Wykresy</h2>
      <p class="subtle text-xs" data-role="wykresy-podpis">
        Zużycie całego VPS-a i usług — bez wchodzenia do Grafany.
      </p>
    </div>
    <div class="wykresy-zakresy" role="group" aria-label="Zakres czasu wykresów" data-role="wykresy-zakresy">
      <button type="button" class="zakres-btn" data-action="wykres-zakres" data-zakres="1h" aria-pressed="false">
        1 h
      </button>
      <button type="button" class="zakres-btn" data-action="wykres-zakres" data-zakres="6h" aria-pressed="true">
        6 h
      </button>
      <button type="button" class="zakres-btn" data-action="wykres-zakres" data-zakres="24h" aria-pressed="false">
        24 h
      </button>
      <button type="button" class="zakres-btn" data-action="wykres-zakres" data-zakres="7d" aria-pressed="false">
        7 d
      </button>
    </div>
    <label class="wykresy-pole">
      <span class="subtle text-xs">Odświeżanie</span>
      <select class="wykresy-select" data-role="wykresy-odswiez" aria-label="Odświeżanie danych">
        {
          ODSWIEZANIA.map((odswiezanie) => (
            <option value={odswiezanie.id} selected={odswiezanie.id === '10s'}>
              {odswiezanie.etykieta}
            </option>
          ))
        }
      </select>
    </label>
  </div>

  <div class="card-ops wykresy-sterowanie">
    <label class="wykresy-pole wykresy-pole-podmiot">
      <span class="subtle text-xs">Podmiot</span>
      <select class="wykresy-select" data-role="wykresy-podmiot" aria-label="Co pokazać na wykresach"></select>
    </label>
    <span class="count-chip num" data-role="wykresy-licznik">—</span>
    <span class="subtle text-xs num" data-role="wykresy-aktualizacja"></span>
    <span class="subtle text-xs" data-role="wykresy-odswiez-podpis"></span>
  </div>

  <p class="wykresy-komunikat subtle" data-role="wykresy-komunikat" role="status" aria-live="polite" hidden></p>

  <section class="card-ops wykresy-top" data-role="wykresy-top" aria-label="Ranking usług">
    <header class="wykresy-top-naglowek">
      <h3 class="card-title">Top 10 usług</h3>
      <div
        class="wykresy-top-metryki"
        role="group"
        aria-label="Metryka rankingu"
        data-role="wykresy-top-metryki"
      >
        <button type="button" class="zakres-btn" data-action="wykres-top" data-metryka="cpu" aria-pressed="true">
          CPU
        </button>
        <button type="button" class="zakres-btn" data-action="wykres-top" data-metryka="ram" aria-pressed="false">
          RAM
        </button>
        <button type="button" class="zakres-btn" data-action="wykres-top" data-metryka="siec" aria-pressed="false">
          Sieć
        </button>
      </div>
      <span class="subtle text-xs" data-role="wykresy-top-podpis">Ranking liczy Prometheus (jedno zapytanie).</span>
    </header>
    <div class="wykresy-top-lista" data-role="wykresy-top-lista"></div>
    <p class="empty-ops" data-role="wykresy-top-pusta" hidden>
      <Icon name="lucide:bar-chart-3" size={16} aria-hidden="true" />
      <span>Brak danych rankingu — Prometheus nie odpowiedział albo brak serii w tym zakresie.</span>
    </p>
  </section>

  <div class="wykresy-sekcje" data-role="wykresy-sekcje"></div>

  <p class="subtle wykresy-stopka text-xs">
    Źródło: <span class="num">/status/api.json</span> (wartości bieżące i limity
    <span class="num">cpu_limit_cores</span> / <span class="num">mem_limit_bytes</span> ze spec usługi),
    <span class="num">node_*</span> z node-exportera (cały VPS) oraz
    <span class="num">/prometheus/api/v1/query_range</span> (przebiegi). Limit RAM bierzemy z API, a gdy go nie ma —
    z metryki <span class="num">swarm_container_memory_limit_bytes</span>. Sieć i dysk nie mają limitu, więc pokazujemy
    przepustowość (rx/tx, odczyt/zapis), a nie procent. Gdy limit nie jest ustawiony, piszemy wprost „limit: brak w API”.
    Najedź na wykres (albo wejdź w niego tabulatorem i użyj strzałek), żeby zobaczyć dokładny punkt w czasie.
  </p>
</section>

<!-- Sekcja: nagłówek podmiotu (VPS albo usługa) + siatka wykresów (maks. 2 w wierszu). -->
<template id="tpl-wykres-sekcja">
  <section class="wykres-sekcja" data-role="wyk-sekcja">
    <header class="wykres-sekcja-naglowek">
      <span class="state-dot" data-role="wyk-dot" aria-hidden="true" hidden></span>
      <h3 class="wykres-sekcja-nazwa">
        <a class="row-name" data-role="wyk-link" href="#/wykresy">
          <span data-role="wyk-nazwa"></span>
        </a>
      </h3>
      <span class="subtle text-xs" data-role="wyk-stack"></span>
      <span class="count-chip num" data-role="wyk-repliki" hidden></span>
      <a class="btn-ops" data-role="wyk-link-stan" href="#/" hidden>
        <Icon name="lucide:activity" size={13} aria-hidden="true" />
        <span>Pokaż w widoku stanu</span>
      </a>
      <button type="button" class="btn-ops" data-action="wykres-usluga" data-role="wyk-szczegoly" hidden>
        <Icon name="lucide:maximize-2" size={13} aria-hidden="true" />
        <span>Szczegóły i diagnostyka</span>
      </button>
      <span class="subtle text-xs" data-role="wyk-sekcja-podpis"></span>
    </header>

    <div class="usluga-diagnostyka" data-role="wyk-diagnostyka" hidden>
      <p class="detail-linia">
        <span class="subtle">Obraz:</span>
        <span class="num" data-role="wyk-d-obraz"></span>
        <span class="subtle">digest:</span>
        <span class="num" data-role="wyk-d-digest"></span>
        <button type="button" class="btn-ops btn-kopiuj" data-action="kopiuj" data-role="wyk-d-kopiuj-obraz">
          Kopiuj obraz
        </button>
      </p>
      <p class="detail-linia detail-liczby">
        <span class="subtle">Zaktualizowano:</span> <span class="num" data-role="wyk-d-updated"></span>
        <span class="subtle">Restarty:</span> <span class="num" data-role="wyk-d-restarty"></span>
        <span class="subtle">Zadanie:</span> <span class="num" data-role="wyk-d-zadanie"></span>
      </p>
      <p class="detail-linia detail-blad" data-role="wyk-d-blad-linia" hidden>
        <span class="subtle">Powód z Dockera:</span>
        <code class="num detail-blad-tresc" data-role="wyk-d-blad"></code>
      </p>
      <div class="detail-linki">
        <button type="button" class="btn-ops btn-kopiuj" data-action="kopiuj" data-role="wyk-d-kopiuj-ps">
          Kopiuj: zadania
        </button>
        <button type="button" class="btn-ops btn-kopiuj" data-action="kopiuj" data-role="wyk-d-kopiuj-logs">
          Kopiuj: logi
        </button>
        <button type="button" class="btn-ops btn-kopiuj" data-action="kopiuj" data-role="wyk-d-kopiuj-inspect">
          Kopiuj: inspect
        </button>
        <a class="btn-ops" data-role="wyk-d-portainer" target="_blank" rel="noopener" hidden>
          <Icon name="lucide:external-link" size={13} aria-hidden="true" />
          <span>Portainer</span>
        </a>
        <span class="subtle text-xs">Panel jest tylko do odczytu — komendy wklej na hoście.</span>
      </div>
    </div>

    <div class="wykres-siatka" data-role="wyk-siatka"></div>
  </section>
</template>

<!-- Wykres: jedna figura na metrykę (CPU, RAM, sieć, dysk, obciążenie). -->
<template id="tpl-wykres">
  <figure class="wykres" data-role="wyk-figura">
    <figcaption class="wykres-naglowek">
      <span class="wykres-tytul" data-role="wyk-tytul"></span>
      <span class="wykres-liczby num" data-role="wyk-liczby"></span>
      <span class="subtle text-xs" data-role="wyk-statystyki"></span>
    </figcaption>
    <div
      class="wykres-plot"
      data-role="wyk-plot"
      tabindex="0"
      role="group"
      aria-label="Wykres — najedź myszą albo użyj strzałek, aby odczytać punkt"
    >
      <svg
        class="wykres-svg"
        viewBox="0 0 800 240"
        preserveAspectRatio="none"
        role="img"
        aria-label="Wykres zużycia"
        data-role="wyk-svg"
      >
        <line class="wykres-siatka" x1="0" y1="30" x2="800" y2="30"></line>
        <line class="wykres-siatka" x1="0" y1="102" x2="800" y2="102"></line>
        <line class="wykres-siatka" x1="0" y1="174" x2="800" y2="174"></line>
        <line class="wykres-siatka" x1="0" y1="240" x2="800" y2="240"></line>
        <polyline class="wykres-linia" data-role="wyk-linia" points=""></polyline>
        <polyline class="wykres-linia wykres-linia-druga" data-role="wyk-linia2" points=""></polyline>
        <polyline class="wykres-linia wykres-linia-limit" data-role="wyk-limit" points=""></polyline>
        <line class="wykres-kursor" data-role="wyk-kursor" x1="0" y1="0" x2="0" y2="240" style="display:none"></line>
        <circle class="wykres-punkt" data-role="wyk-punkt" r="4" cx="0" cy="0" style="display:none"></circle>
        <circle class="wykres-punkt wykres-punkt-druga" data-role="wyk-punkt2" r="4" cx="0" cy="0" style="display:none"></circle>
      </svg>
      <div class="wykres-tooltip" data-role="wyk-tooltip" hidden>
        <span class="wykres-tooltip-czas num" data-role="wyk-tooltip-czas"></span>
        <div class="wykres-tooltip-wiersze" data-role="wyk-tooltip-wiersze"></div>
      </div>
      <span class="wykres-os wykres-os-gora num" data-role="wyk-os-gora"></span>
      <span class="wykres-os wykres-os-srodek num" data-role="wyk-os-srodek"></span>
      <span class="wykres-os wykres-os-dol num" data-role="wyk-os-dol"></span>
    </div>
    <div class="wykres-czas subtle num">
      <span data-role="wyk-czas-od"></span>
      <span data-role="wyk-czas-do"></span>
    </div>
  </figure>
</template>

<!-- Wiersz rankingu „Top 10": nazwa, słupek, wartość. -->
<template id="tpl-wykres-top">
  <div class="top-wiersz" data-role="top-wiersz">
    <a class="top-nazwa row-name" data-role="top-nazwa" href="#/wykresy"></a>
    <span class="top-slup" aria-hidden="true">
      <span class="top-slup-wypelnienie" data-role="top-slup"></span>
    </span>
    <span class="top-wartosc num" data-role="top-wartosc"></span>
  </div>
</template>
