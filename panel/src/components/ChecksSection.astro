---
/**
 * Sekcja (a): publiczne endpointy z `checks[]`, pogrupowane po `group`
 * (kolejność grup taka jak w odpowiedzi API).
 *
 * Wiersz jest jednoliniowy: nazwa i szczegół obok siebie, potem opóźnienie,
 * czas od zmiany stanu i akcja. Przy 16 endpointach dwa wiersze tekstu na
 * pozycję dawały ponad 1200 px wysokości — teraz sekcja jest o połowę krótsza
 * i mieści się obok alertów na szerokim ekranie.
 */
import { Icon } from 'astro-icon/components';
import SectionCard from './SectionCard.astro';
---

<SectionCard section="checks" title="Publiczne endpointy" icon="lucide:globe">
  <div data-role="groups"></div>
  <div class="empty-ops" data-role="empty" hidden>
    <Icon name="lucide:inbox" size={16} aria-hidden="true" />
    <span>Brak danych o endpointach — API nie zwróciło listy sond.</span>
  </div>
  <div class="empty-ops" data-role="empty-filtr" hidden>
    <Icon name="lucide:search-x" size={16} aria-hidden="true" />
    <span>Żaden endpoint nie pasuje do filtra.</span>
  </div>
</SectionCard>

<template id="tpl-check-group">
  <section class="border-b border-base-300 last:border-b-0" data-role="group" data-state="unknown">
    <header class="flex flex-wrap items-center gap-2 px-4 pt-2.5 pb-1">
      <h3 class="text-xs font-semibold tracking-wide uppercase" data-role="group-name"></h3>
      <span class="count-chip" data-role="group-count"></span>
      <span
        class="state-pill ml-auto"
        data-role="group-rollup"
        role="img"
        aria-label="Stan grupy: nieznany"
      >
        <span class="state-dot" aria-hidden="true"></span>
        <span data-role="group-rollup-label">Nieznany</span>
      </span>
    </header>
    <div data-role="rows"></div>
  </section>
</template>

<template id="tpl-check-row">
  <div class="row-ops" data-role="row" data-state="unknown">
    <span class="state-dot" aria-hidden="true"></span>
    <span class="flex min-w-0 flex-1 flex-wrap items-baseline gap-x-2">
      <span class="truncate text-sm font-medium" data-role="name"></span>
      <span class="subtle truncate text-xs" data-role="detail"></span>
    </span>
    <span class="num w-[4.5rem] shrink-0 text-right text-xs" data-role="latency"></span>
    <span
      class="subtle hidden w-[5.5rem] shrink-0 text-right text-xs xl:inline"
      data-role="since"></span>
    <a class="link-ops text-xs" data-role="link" target="_blank" rel="noopener" hidden>
      <span>Otwórz</span>
      <Icon name="lucide:external-link" size={12} aria-hidden="true" />
    </a>
  </div>
</template>
