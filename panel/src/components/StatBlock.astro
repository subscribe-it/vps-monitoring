---
/**
 * Pojedynczy blok wartości (sekcje kopii zapasowej i bezpieczeństwa).
 * Skrypt klienta wypełnia `[data-role="value"]` i `[data-role="sub"]`,
 * a `data-state` steruje kolorem.
 *
 * Siatkę rozmieszcza rodzic (`.field-grid` — auto-fit), więc blok sam nie
 * narzuca szerokości: na szerokim ekranie sześć pól kopii zapasowej układa się
 * w jednym rzędzie wypełniającym kartę, zamiast zostawiać puste miejsce.
 */
import { Icon } from 'astro-icon/components';

interface Props {
  /** Klucz pola, np. `backup-last` — skrypt szuka `[data-field="backup-last"]`. */
  field: string;
  label: string;
  icon?: string;
}

const { field, label, icon } = Astro.props;
---

<div class="stat-tile" data-field={field} data-state="unknown">
  <div class="flex items-center gap-1.5">
    {icon && <Icon name={icon} size={13} class="state-text" aria-hidden="true" />}
    <span class="card-title text-xs">{label}</span>
  </div>
  <p class="num text-base leading-tight font-semibold" data-role="value">—</p>
  <p class="subtle line-clamp-2 text-xs leading-snug" data-role="sub">—</p>
</div>
