---
/**
 * Pojedynczy blok wartości (używany w sekcjach kopii zapasowej i bezpieczeństwa).
 * Skrypt klienta wypełnia `[data-role="value"]` i `[data-role="sub"]`,
 * a `data-state` steruje kolorem.
 */
import { Icon } from 'astro-icon/components';

interface Props {
  /** Klucz pola, np. `backup-last` — skrypt szuka `[data-field="backup-last"]`. */
  field: string;
  label: string;
  icon?: string;
}

const { field, label, icon } = Astro.props;
---

<div
  class="rounded-[var(--radius-box)] border border-base-300 bg-base-200 px-3 py-2.5"
  data-field={field}
  data-state="unknown"
>
  <div class="flex items-center gap-1.5">
    {icon && <Icon name={icon} size={13} class="state-text" aria-hidden="true" />}
    <span class="card-title text-[11px]">{label}</span>
  </div>
  <p class="num mt-1.5 text-[15px] font-semibold" data-role="value">—</p>
  <p class="subtle mt-1 text-[11px] leading-tight" data-role="sub">—</p>
</div>
