# Kontekstem budowania jest katalog główny repo — obrazy kopiują z config/,
# services/ i dockerfiles/, więc te katalogi MUSZĄ zostać w kontekście.

# Git i CI
.git
.gitignore
.github

# Dokumentacja i testy (nie są potrzebne w obrazach)
*.md
docs/
tests/

# Pliki środowiskowe i sekrety
.env
.env.*
env.*
!env.portainer.example

# Zależności i artefakty panelu (panel ma własny .dockerignore)
panel/node_modules
panel/dist
panel/.astro

# IDE / OS / logi
.vscode
.idea
*.swp
*.swo
.DS_Store
Thumbs.db
*.log
tmp/
temp/
*.tmp
